---
import Base from '../layouts/Base.astro';

if (Astro.locals.session) {
  return Astro.redirect('/');
}

let errorMessage = '';
const errorParam = Astro.url.searchParams.get('error');
if (errorParam === 'auth_failed') errorMessage = '이메일 또는 비밀번호가 맞지 않아요.';
if (errorParam === 'locked') errorMessage = '로그인 시도가 너무 많아요. 잠시 후 다시 시도해주세요.';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  const password = String(form.get('password') ?? '');

  const { error } = await Astro.locals.supabase.auth.signInWithPassword({ email, password });
  if (error) {
    return Astro.redirect('/login?error=auth_failed');
  }
  return Astro.redirect('/');
}
---
<Base title="로그인 — 테드픽">
  <div class="auth-page">
    <div class="auth-inner">

      <div class="auth-top">
        <h1 class="auth-h1">다시 만나서<br/>반가워요</h1>
        <p class="auth-sub">가입한 이메일과 비밀번호를 입력해 주세요.</p>
      </div>

      {errorMessage && (
        <div class="auth-error">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6"/>
            <path d="M10 6v4.5M10 13.2v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          {errorMessage}
        </div>
      )}

      <form method="POST" class="auth-form" id="login-form">
        <div class="field">
          <label class="field-label" for="email">이메일</label>
          <input class="field-input" id="email" type="email" name="email" required autocomplete="email" placeholder="ted@example.com" />
        </div>

        <div class="field">
          <label class="field-label" for="password">비밀번호</label>
          <div class="field-pw-wrap">
            <input class="field-input" id="password" type="password" name="password" required autocomplete="current-password" placeholder="비밀번호 입력" />
            <button type="button" class="pw-toggle" id="pw-toggle" aria-label="비밀번호 보기">
              <svg id="eye-show" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M3 10s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="10" cy="10" r="2.2" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <svg id="eye-hide" width="20" height="20" viewBox="0 0 20 20" fill="none" style="display:none">
                <path d="M3 10s2.5-5 7-5c1.4 0 2.6.5 3.6 1.2M17 10s-2.5 5-7 5c-1.4 0-2.6-.5-3.6-1.2M3 3l14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="auth-row">
          <label class="auto-login-label">
            <span class="auto-login-box" id="auto-box">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="m2.5 6 2.5 2.5L9.5 3.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <input type="checkbox" name="remember" style="display:none" id="auto-check" checked />
            <span class="auto-login-text">자동 로그인</span>
          </label>
          <a href="/forgot-password" class="micro-link">비밀번호 찾기</a>
        </div>

        <div class="auth-spacer"></div>

        <button class="btn-auth-primary" type="submit">로그인</button>
      </form>

      <p class="auth-switch">처음이세요? <a href="/signup">회원가입</a></p>

    </div>
  </div>
</Base>

<style>
  .auth-page {
    min-height: calc(100svh - 57px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 24px 32px;
  }
  .auth-inner {
    width: 100%;
    max-width: 390px;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 40px;
  }

  .auth-top { margin-bottom: 32px; }
  .auth-h1 {
    font-size: 28px;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 8px;
  }
  .auth-sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--up);
    background: var(--up-bg);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 20px;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  /* Fields */
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }
  .field-input {
    height: 52px;
    border-radius: 12px;
    border: 1.5px solid var(--divider);
    background: var(--card);
    padding: 0 16px;
    font-family: var(--font);
    font-size: 16px;
    color: var(--text-1);
    letter-spacing: -0.01em;
    outline: none;
    transition: border-color 140ms, background 140ms;
    width: 100%;
  }
  .field-input::placeholder { color: var(--text-3); }
  .field-input:focus { border-color: var(--blue); background: #fff; }

  /* Password wrapper */
  .field-pw-wrap { position: relative; }
  .field-pw-wrap .field-input { padding-right: 48px; }
  .pw-toggle {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    padding: 4px;
    color: var(--text-3);
    display: flex;
    align-items: center;
  }

  /* Auto login row */
  .auth-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
  }
  .auto-login-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .auto-login-box {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--blue);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 140ms;
    flex-shrink: 0;
  }
  .auto-login-box.unchecked {
    background: transparent;
    border: 1.5px solid var(--divider);
  }
  .auto-login-box.unchecked svg { display: none; }
  .auto-login-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }
  .micro-link {
    color: var(--text-3);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .micro-link:hover { color: var(--text-2); }

  /* Spacer pushes button to bottom */
  .auth-spacer { flex: 1; min-height: 24px; }

  /* Primary button */
  .btn-auth-primary {
    width: 100%;
    height: 54px;
    border-radius: 14px;
    background: var(--blue);
    color: #fff;
    font-family: var(--font);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 140ms, transform 140ms;
    border: none;
    margin-bottom: 14px;
  }
  .btn-auth-primary:active { transform: scale(0.985); opacity: 0.9; }

  .auth-switch {
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }
  .auth-switch a {
    color: var(--blue);
    font-weight: 700;
    margin-left: 4px;
  }
  .auth-switch a:hover { text-decoration: underline; }
</style>

<script>
  // Eye toggle
  const pwInput = document.getElementById('password') as HTMLInputElement;
  const toggle = document.getElementById('pw-toggle');
  const eyeShow = document.getElementById('eye-show');
  const eyeHide = document.getElementById('eye-hide');
  toggle?.addEventListener('click', () => {
    const isText = pwInput.type === 'text';
    pwInput.type = isText ? 'password' : 'text';
    eyeShow!.style.display = isText ? '' : 'none';
    eyeHide!.style.display = isText ? 'none' : '';
  });

  // Auto-login checkbox
  const autoBox = document.getElementById('auto-box');
  const autoCheck = document.getElementById('auto-check') as HTMLInputElement;
  autoBox?.addEventListener('click', () => {
    autoCheck.checked = !autoCheck.checked;
    autoBox.classList.toggle('unchecked', !autoCheck.checked);
  });

  // Add has-value border on input
  document.querySelectorAll('.field-input').forEach(input => {
    input.addEventListener('input', function() {
      (this as HTMLInputElement).style.borderColor = (this as HTMLInputElement).value ? 'var(--text-1)' : '';
    });
  });
</script>
