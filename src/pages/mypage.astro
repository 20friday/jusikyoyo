---
import Base from '../layouts/Base.astro';

if (!Astro.locals.session) {
  return Astro.redirect('/login');
}

const user = Astro.locals.user!;

const { data: profile } = await Astro.locals.supabase
  .from('profiles')
  .select('role, expires_at, is_admin')
  .eq('user_id', user.id)
  .single();

const email = user.email ?? '';
const initial = email.charAt(0).toUpperCase();
const nickname = user.user_metadata?.full_name ?? user.user_metadata?.name ?? '';

const role = profile?.role ?? 'free';
const expiresAt = profile?.expires_at ? new Date(profile.expires_at) : null;

const now = new Date();
const isExpired = expiresAt ? expiresAt < now : true;

function roleBadge(r: string) {
  if (r === 'paid') return { label: '구독 중', color: '#ed781f' };
  if (r === 'trial') return isExpired
    ? { label: '체험 만료', color: '#999' }
    : { label: '무료 체험 중', color: '#3b82f6' };
  return { label: '무료', color: '#999' };
}

const badge = roleBadge(role);

function formatExpiry(d: Date) {
  const days = ['일', '월', '화', '수', '목', '금', '토'];
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
}

function daysLeft(d: Date) {
  const diff = d.getTime() - now.getTime();
  return Math.max(0, Math.ceil(diff / (1000 * 60 * 60 * 24)));
}
---
<Base title="내 계정">
  <div class="mypage-wrap">

    <!-- 프로필 -->
    <div class="profile-card">
      <div class="avatar">{initial}</div>
      {nickname && <div class="nickname">{nickname}</div>}
      <div class="email">{email}</div>
      <div class="role-badge" style={`background: color-mix(in srgb, ${badge.color} 12%, transparent); color: ${badge.color};`}>
        {badge.label}
      </div>
    </div>

    <!-- 구독 상태 -->
    <div class="info-section">
      <div class="section-title">구독 상태</div>

      {role === 'paid' && (
        <div class="info-row">
          <span class="info-label">상태</span>
          <span class="info-value paid">구독 중</span>
        </div>
      )}

      {role === 'trial' && !isExpired && expiresAt && (
        <>
          <div class="info-row">
            <span class="info-label">상태</span>
            <span class="info-value trial">무료 체험 중</span>
          </div>
          <div class="info-row">
            <span class="info-label">체험 만료일</span>
            <span class="info-value">{formatExpiry(expiresAt)}</span>
          </div>
          <div class="info-row">
            <span class="info-label">남은 기간</span>
            <span class="info-value">{daysLeft(expiresAt)}일</span>
          </div>
        </>
      )}

      {role === 'trial' && isExpired && (
        <div class="info-row">
          <span class="info-label">상태</span>
          <span class="info-value expired">체험 기간 만료</span>
        </div>
      )}

      {role === 'free' && (
        <div class="info-row">
          <span class="info-label">상태</span>
          <span class="info-value">무료 이용 중</span>
        </div>
      )}
    </div>

    <!-- 계정 -->
    <div class="info-section">
      <div class="section-title">계정</div>
      <div class="info-row">
        <span class="info-label">이메일</span>
        <span class="info-value">{email}</span>
      </div>
    </div>

    <!-- 로그아웃 -->
    <form method="POST" action="/api/auth/logout" class="logout-form">
      <button type="submit" class="logout-btn">로그아웃</button>
    </form>

  </div>
</Base>

<style>
  .mypage-wrap {
    max-width: 480px;
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  /* 프로필 카드 */
  .profile-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 24px 28px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    margin-bottom: 16px;
    text-align: center;
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #ed781f;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    letter-spacing: -0.02em;
  }

  .nickname {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 4px;
  }

  .email {
    font-size: 15px;
    color: var(--text-3);
    margin-bottom: 14px;
  }

  .role-badge {
    font-size: 13px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 20px;
    letter-spacing: -0.01em;
  }

  /* 정보 섹션 */
  .info-section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 12px;
  }

  .section-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-3);
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    gap: 12px;
  }
  .info-row:last-child { border-bottom: none; padding-bottom: 0; }
  .info-row:first-of-type { padding-top: 0; }

  .info-label {
    font-size: 15px;
    color: var(--text-3);
    flex-shrink: 0;
  }

  .info-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-1);
    text-align: right;
  }

  .info-value.paid   { color: #ed781f; }
  .info-value.trial  { color: #3b82f6; }
  .info-value.expired { color: #999; }

  /* 로그아웃 */
  .logout-form { margin-top: 8px; }

  .logout-btn {
    width: 100%;
    padding: 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 17px;
    font-weight: 600;
    color: var(--text-2);
    cursor: pointer;
    font-family: var(--font);
    transition: background 140ms ease;
  }
  .logout-btn:active { background: var(--border); }
</style>
