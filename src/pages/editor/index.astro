---
import Base from '../../layouts/Base.astro';
---
<Base title="에디터">
  <div id="editor-root" style="height: calc(100vh - 57px);">
    <noscript>에디터를 사용하려면 JavaScript를 활성화하세요.</noscript>
  </div>
</Base>

<script>
  // Dynamically import the React editor to avoid SSR issues
  import('../../components/editor/EditorApp').then(({ mount }) => {
    mount(document.getElementById('editor-root')!);
  });
</script>
