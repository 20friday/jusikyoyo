---
import Base from '../../layouts/Base.astro';

const { date } = Astro.params;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const { data: report } = await Astro.locals.supabase
  .from('weekly_reports')
  .select('*')
  .eq('date', date)
  .single();

const sectorsJson = JSON.stringify(report?.sectors ?? []);
const stocksJson  = JSON.stringify(report?.stocks  ?? []);
---
<Base title="주간 PICK 리포트" description="이번 주 방송 종합 리포트">
  {!report ? (
    <div style="text-align:center;padding:80px 24px;color:var(--text-3);">
      <p style="font-size:32px;margin-bottom:12px;">📭</p>
      <p style="font-size:16px;font-weight:700;">리포트를 찾을 수 없어요</p>
    </div>
  ) : (
    <div class="report-wrap">

      <!-- 1. 주간 한 줄 요약 (히어로) -->
      <div class="report-hero">
        <div class="report-hero-label">
          <span class="report-hero-label-pick">주간 PICK 리포트</span> · {report.period}
        </div>
        <div class="report-hero-headline">{report.headline}</div>
      </div>

      <!-- 2. 주간 인사이트 -->
      <div class="report-section">
        <div class="report-section-label">주간 인사이트</div>
        <div class="weekly-insight">
          {report.insight.map((para: string) => (
            <p class="weekly-insight-para">{para}</p>
          ))}
        </div>
      </div>

      <!-- 3. 이번 주 반복 언급 섹터 -->
      <div class="report-section">
        <div class="report-section-label">이번 주 반복 언급 섹터</div>
        {report.sectors.map((sector: any, i: number) => (
          <button class="stock-row stock-row--clickable" data-type="sector" data-index={i}>
            <div class="stock-row-left">
              <span class="stock-name">{sector.name}</span>
            </div>
            <div class="stock-row-right">
              <span class="stock-shows stock-flow-preview">{sector.flow}</span>
              <span class="stock-row-chevron">›</span>
            </div>
          </button>
        ))}
      </div>

      <!-- 4. 이번 주 공통 언급 종목 -->
      <div class="report-section">
        <div class="report-section-label">이번 주 공통 언급 종목</div>
        {report.stocks.map((stock: any, i: number) => (
          <button class="stock-row stock-row--clickable" data-type="stock" data-index={i}>
            <div class="stock-row-left">
              <span class="stock-rank">#{i + 1}</span>
              <span class="stock-name">{stock.name}</span>
            </div>
            <div class="stock-row-right">
              <span class="stock-shows">{stock.days === 5 ? '5일 내내' : `${stock.days}일`}</span>
              <span class="stock-row-chevron">›</span>
            </div>
          </button>
        ))}
      </div>

      <!-- 5. 여러 방송에서 관점이 갈린 종목 -->
      <div class="report-section">
        <div class="report-section-label">여러 방송에서 관점이 갈린 종목</div>
        {report.splits.map((split: any) => (
          <div class="sector-row">
            <div class="sector-name">{split.name}</div>
            <div class="sector-flow">{split.desc}</div>
          </div>
        ))}
      </div>

      <!-- 6. 이번 주 전문가들이 갈린 지점 -->
      <div class="report-section">
        <div class="report-section-label">이번 주 전문가들이 갈린 지점</div>
        {report.gaps.map((gap: string) => (
          <div class="weekly-gap" set:html={gap} />
        ))}
      </div>

      <!-- 7. 다음 주까지 이어서 봐야 할 종목 -->
      <div class="report-section">
        <div class="report-section-label">다음 주까지 이어서 봐야 할 종목</div>
        <div class="weekly-chips">
          {report.watchlist.map((item: any) => (
            <span class="weekly-chip">{item.name}</span>
          ))}
        </div>
      </div>

      <!-- 8. 다음 주 체크 포인트 -->
      <div class="report-section">
        <div class="report-section-label">다음 주 체크 포인트</div>
        {report.checkpoints.map((point: string) => (
          <div class="weekly-checkpoint">
            <span class="weekly-checkpoint-dot">·</span>
            <span class="weekly-checkpoint-text">{point}</span>
          </div>
        ))}
      </div>

    </div>
  )}

  <!-- 공용 모달 -->
  <div id="weekly-modal-backdrop" class="weekly-modal-backdrop"></div>
  <div id="weekly-modal" class="weekly-modal" aria-hidden="true" role="dialog">
    <div class="weekly-modal-inner">
      <div id="weekly-modal-content" class="weekly-modal-content"></div>
      <button id="weekly-modal-close" class="weekly-modal-close" aria-label="닫기">닫기</button>
    </div>
  </div>
</Base>

<style>
  /* ── weekly 전용 ── */
  .weekly-insight-para {
    font-size: 17px;
    color: var(--text-2);
    line-height: 1.8;
    margin-bottom: 8px;
  }
  .weekly-insight-para:last-child { margin-bottom: 0; }

  .weekly-gap {
    font-size: 17px;
    color: var(--text-2);
    line-height: 1.75;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .weekly-gap:last-child { border-bottom: none; padding-bottom: 0; }
  .weekly-gap strong { color: var(--text-1); font-weight: 700; }

  .weekly-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .weekly-chip {
    background: #fff3ea;
    border: 1.5px solid var(--blue);
    border-radius: 20px;
    padding: 7px 16px;
    font-size: 15px;
    font-weight: 700;
    color: var(--blue);
  }

  .weekly-checkpoint {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .weekly-checkpoint:last-child { border-bottom: none; padding-bottom: 0; }
  .weekly-checkpoint-dot { color: var(--blue); font-weight: 700; flex-shrink: 0; line-height: 1.75; }
  .weekly-checkpoint-text { font-size: 17px; color: var(--text-2); line-height: 1.75; }

  /* ── 클릭 가능한 행 ── */
  .stock-row--clickable {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .stock-row--clickable:active { opacity: 0.7; }

  .stock-row-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stock-flow-preview {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
  }
  .stock-row-chevron {
    font-size: 20px;
    color: var(--text-3);
    line-height: 1;
    flex-shrink: 0;
  }

  /* ── 모달 ── */
  .weekly-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 100;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .weekly-modal-backdrop.open { display: block; }

  .weekly-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 101;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }
  .weekly-modal.open { display: flex; }

  .weekly-modal-inner {
    background: var(--card);
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: wmodal-in 220ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  @keyframes wmodal-in {
    from { opacity: 0; transform: scale(0.95); }
    to   { opacity: 1; transform: scale(1); }
  }

  .weekly-modal-close {
    display: block;
    flex-shrink: 0;
    width: calc(100% - 40px);
    margin: 8px 20px 20px;
    padding: 16px;
    border-radius: 14px;
    background: var(--border);
    border: none;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    cursor: pointer;
    font-family: var(--font);
  }
  .weekly-modal-close:active { background: var(--divider); }

  .weekly-modal-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px 20px 8px;
  }
</style>

<script define:vars={{ sectorsJson, stocksJson }}>
  const sectors = JSON.parse(sectorsJson);
  const stocks  = JSON.parse(stocksJson);

  const backdrop = document.getElementById('weekly-modal-backdrop');
  const sheet    = document.getElementById('weekly-modal');
  const content  = document.getElementById('weekly-modal-content');

  function openModal(html) {
    content.innerHTML = html;
    backdrop.classList.add('open');
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    backdrop.classList.remove('open');
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.stock-row--clickable').forEach(btn => {
    btn.addEventListener('click', () => {
      const type  = btn.dataset.type;
      const index = Number(btn.dataset.index);
      let html = '';

      if (type === 'sector') {
        const s = sectors[index];
        if (!s) return;
        html  = `<div class="sheet-stock-name">${s.name}</div>`;
        html += `<div class="sheet-stock-shows">반복 언급 섹터</div>`;
        html += `<div class="sheet-point"><span class="sheet-point-body">${s.flow}</span></div>`;

      } else if (type === 'stock') {
        const s = stocks[index];
        if (!s) return;
        const daysLabel = s.days === 5 ? '5일 내내' : `${s.days}일`;
        html  = `<div class="sheet-stock-name">${s.name}</div>`;
        html += `<div class="sheet-stock-shows">이번 주 ${daysLabel} 언급</div>`;

        if (s.notes && s.notes.length > 0) {
          s.notes.forEach(n => {
            html += `<div class="sheet-point"><span class="sheet-point-show">${n.show}</span><span class="sheet-point-body">${n.view}</span></div>`;
          });
        } else if (s.reason) {
          html += `<div class="sheet-point"><span class="sheet-point-body">${s.reason}</span></div>`;
        } else {
          html += `<div class="sheet-no-comp">이 종목은 이번 주 여러 방송에서 언급됐지만, 별도 내용 정리가 없어요.</div>`;
        }

        html += `<a class="sheet-history" href="/stock/${s.name}">방송 언급 히스토리 보기 →</a>`;
      }

      openModal(html);
    });
  });

  sheet.addEventListener('click', closeModal);
  document.getElementById('weekly-modal-close').addEventListener('click', closeModal);
  document.querySelector('.weekly-modal-inner').addEventListener('click', e => e.stopPropagation());
</script>

<script>
  const hero    = document.querySelector('.report-hero') as HTMLElement;
  const hdrInner = document.querySelector('.hdr-inner') as HTMLElement;

  if (hero && hdrInner) {
    const ctx = document.createElement('div');
    ctx.className = 'hdr-ctx';

    const backBtn = document.createElement('button');
    backBtn.className = 'hdr-back-btn';
    backBtn.setAttribute('aria-label', '뒤로');
    backBtn.textContent = '←';
    backBtn.addEventListener('click', () => history.back());

    const label = document.createElement('span');
    label.className = 'hdr-ctx-label';
    label.textContent = '주간 PICK 리포트';

    ctx.appendChild(backBtn);
    ctx.appendChild(label);
    hdrInner.appendChild(ctx);

    const observer = new IntersectionObserver(
      ([entry]) => { hdrInner.classList.toggle('is-scrolled', !entry.isIntersecting); },
      { threshold: 0, rootMargin: '-56px 0px 0px 0px' }
    );
    observer.observe(hero);
  }
</script>

<script define:vars={{ date, supabaseUrl, supabaseKey }}>
  fetch(`${supabaseUrl}/rest/v1/rpc/increment_weekly_report_view`, {
    method: 'POST',
    headers: { 'apikey': supabaseKey, 'Authorization': `Bearer ${supabaseKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ report_date: date }),
  });
</script>
