---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, show, hosts, summary, tags } = post.data;
const { Content } = await render(post);

const days = ['일', '월', '화', '수', '목', '금', '토'];
const d = new Date(date + 'T00:00:00');
const dateKo = `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
---
<Base title={title} description={summary}>
  <div class="post-wrap">
    <article>
      <div class="detail-meta">
        <span class="detail-show">{show}</span>
        <span class="card-dot"></span>
        <span class="detail-date">{dateKo}</span>
        <span class="card-dot"></span>
        <span class="detail-hosts">{hosts.join(' · ')}</span>
      </div>
      <h1 class="detail-title">{title}</h1>
      <p class="detail-summary">{summary}</p>
      {tags.length > 0 && (
        <div class="detail-tags">
          {tags.map(t => <span class="tag">{t}</span>)}
        </div>
      )}
      <hr class="detail-divider" />
      <div class="prose">
        <Content />
      </div>
    </article>

    <div class="post-footer">
      <a href="/" class="btn-pill ghost">← 피드로</a>
    </div>
  </div>
</Base>

<style>
  .post-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 16px 80px;
  }
  .post-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
</style>
