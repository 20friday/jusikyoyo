---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, show, hosts, summary, tags } = post.data;
const { Content } = await render(post);

const days = ['일', '월', '화', '수', '목', '금', '토'];
const d = new Date(date + 'T00:00:00');
const dateKo = `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
---
<Base title={title} description={summary}>
  <div class="page">
    <article class="main-col">
      <div class="post-detail">
        <div class="detail-meta">
          <span class="detail-show">{show}</span>
          <span class="card-dot"></span>
          <span class="detail-date">{dateKo}</span>
          <span class="card-dot"></span>
          <span class="detail-hosts">{hosts.join(' · ')}</span>
        </div>
        <h1 class="detail-title">{title}</h1>
        <p class="detail-summary">{summary}</p>
        {tags.length > 0 && (
          <div class="detail-tags">
            {tags.map(t => <span class="tag">{t}</span>)}
          </div>
        )}
        <hr class="detail-divider" />
        <div class="prose">
          <Content />
        </div>
      </div>
    </article>

    <aside class="sidebar">
      <div class="sidebar-card">
        <p class="sec-title">이 글 정보</p>
        <p style="font-size:13px; color:var(--text-2); line-height:1.6;">
          <strong>{show}</strong><br />
          {hosts.join(', ')}<br />
          {dateKo}
        </p>
      </div>
      {tags.length > 0 && (
        <div class="sidebar-card">
          <p class="sec-title">태그</p>
          <div class="card-tags">
            {tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </div>
      )}
      <div class="sidebar-card">
        <a href="/" class="btn-pill ghost" style="width:100%; justify-content:center;">← 피드로</a>
        <a href={`/editor?slug=${post.id}`} class="btn-pill ghost" style="width:100%; justify-content:center; margin-top:8px;">글 편집</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .main-col { min-width: 0; }
</style>
