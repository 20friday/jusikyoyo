---
import Base from '../../layouts/Base.astro';
import { stockInfo } from '../../lib/stockInfo';
import { renderMarkdown } from '../../lib/renderMarkdown';

const { slug } = Astro.params;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const { data: post, error } = await Astro.locals.supabase
  .from('posts')
  .select('title, content, slug, show, hosts, summary, tags, date, is_premium, display_order')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (!post || error) {
  return Astro.redirect('/');
}

const { title, content, show, summary, tags, date } = post;
const contentHtml = await renderMarkdown(content ?? '');

const days = ['일', '월', '화', '수', '목', '금', '토'];
const d = new Date(date + 'T00:00:00');
const dateKo = `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;

const stockInfoJson = JSON.stringify(stockInfo);
---
<Base title={title} description={summary}>
  <div class="post-wrap">
    <article>
      <div class="detail-meta">
        <span class="detail-show">{show}</span>
        <span class="card-dot"></span>
        <span class="detail-date">{dateKo}</span>
      </div>
      <h1 class="detail-title">{title}</h1>
      <p class="detail-summary">{summary}</p>
      <hr class="detail-divider" />
      <div class="prose" set:html={contentHtml} />
    </article>

    <div class="post-footer">
      <a href="/" class="btn-pill ghost">← 뒤로</a>
    </div>
  </div>

  <!-- 종목 모달 -->
  <div id="stock-modal-backdrop" class="stock-modal-backdrop"></div>
  <div id="stock-modal" class="stock-modal" aria-hidden="true" role="dialog">
    <div class="stock-modal-inner">
      <div id="stock-modal-content" class="stock-modal-content"></div>
      <button id="stock-modal-close" class="stock-modal-close" aria-label="닫기">닫기</button>
    </div>
  </div>
</Base>

<style>
.post-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px 16px 80px;
  }
  .post-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  :global(.block-stock) {
    cursor: pointer;
    transition: opacity 0.15s;
  }
  :global(.block-stock:active) {
    opacity: 0.65;
  }

  .stock-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 100;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .stock-modal-backdrop.open { display: block; }

  .stock-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 101;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }
  .stock-modal.open { display: flex; }

  .stock-modal-inner {
    background: var(--card);
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    animation: modal-in 220ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: scale(0.95); }
    to   { opacity: 1; transform: scale(1); }
  }

  .stock-modal-close {
    display: block;
    flex-shrink: 0;
    width: calc(100% - 40px);
    margin: 8px 20px 20px;
    padding: 16px;
    border-radius: 14px;
    background: var(--border);
    border: none;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    cursor: pointer;
    font-family: var(--font);
  }
  .stock-modal-close:active { background: var(--divider); }

  .stock-modal-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 24px 20px 8px;
  }

  :global(.smi-sector) {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: var(--blue);
    background: color-mix(in srgb, var(--blue) 12%, transparent);
    border-radius: 6px;
    padding: 2px 8px;
    margin-bottom: 10px;
  }
  :global(.smi-name) {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-1);
    margin-bottom: 10px;
  }
  :global(.smi-desc) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-2);
  }
  :global(.smi-unknown) {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.6;
  }
  :global(.smi-history) {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
  }
  :global(.smi-history:hover) { text-decoration: underline; }
</style>

<script>
  const meta = document.querySelector('.detail-meta') as HTMLElement;
  const hdrInner = document.querySelector('.hdr-inner') as HTMLElement;
  const showEl = document.querySelector('.detail-show') as HTMLElement;

  if (meta && hdrInner && showEl) {
    const ctx = document.createElement('div');
    ctx.className = 'hdr-ctx';

    const backBtn = document.createElement('button');
    backBtn.className = 'hdr-back-btn';
    backBtn.setAttribute('aria-label', '뒤로');
    backBtn.textContent = '←';
    backBtn.addEventListener('click', () => history.back());

    const label = document.createElement('span');
    label.className = 'hdr-ctx-label';
    label.textContent = showEl.textContent;

    ctx.appendChild(backBtn);
    ctx.appendChild(label);
    hdrInner.appendChild(ctx);

    const observer = new IntersectionObserver(
      ([entry]) => {
        hdrInner.classList.toggle('is-scrolled', !entry.isIntersecting);
      },
      { threshold: 0, rootMargin: '-56px 0px 0px 0px' }
    );
    observer.observe(meta);
  }
</script>

<script define:vars={{ stockInfoJson }}>
  const stockInfo = JSON.parse(stockInfoJson);
  const backdrop = document.getElementById('stock-modal-backdrop');
  const sheet = document.getElementById('stock-modal');
  const content = document.getElementById('stock-modal-content');

  function openModal(stockName) {
    const info = stockInfo.find(s => s.name === stockName);
    const historyLink = `<a class="smi-history" href="/stock/${encodeURIComponent(stockName)}">방송 언급 히스토리 보기 →</a>`;
    if (info) {
      content.innerHTML = `
        <div class="smi-sector">${info.sector}</div>
        <div class="smi-name">${info.name}</div>
        <div class="smi-desc">${info.desc}</div>
        ${historyLink}
      `;
    } else {
      content.innerHTML = `
        <div class="smi-name">${stockName}</div>
        <div class="smi-unknown">이 종목에 대한 설명이 아직 준비되지 않았어요.</div>
        ${historyLink}
      `;
    }
    backdrop.classList.add('open');
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    backdrop.classList.remove('open');
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.block-stock').forEach(el => {
    el.addEventListener('click', () => {
      const name = el.querySelector('.block-stock-name')?.textContent?.trim() ?? '';
      if (name) openModal(name);
    });
  });

  sheet.addEventListener('click', closeModal);
  document.getElementById('stock-modal-close').addEventListener('click', closeModal);
  document.querySelector('.stock-modal-inner').addEventListener('click', e => e.stopPropagation());
</script>

<script>
  // 볼드 타이틀만 있는 단락의 아래 여백을 줄여 타이틀+설명이 묶여 보이도록
  document.querySelectorAll('.prose p').forEach(p => {
    const nodes = [...p.childNodes].filter(n => n.nodeType !== 3 || n.textContent.trim());
    if (nodes.length === 1 && nodes[0].tagName === 'STRONG') {
      p.style.marginBottom = '4px';
    }
  });
</script>

<script define:vars={{ slug, supabaseUrl, supabaseKey }}>
  fetch(`${supabaseUrl}/rest/v1/rpc/increment_post_view`, {
    method: 'POST',
    headers: { 'apikey': supabaseKey, 'Authorization': `Bearer ${supabaseKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ post_slug: slug }),
  });
</script>
