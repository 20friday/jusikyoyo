---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allWeeklyReports = await getCollection('weeklyReports');
const latestWeekly = allWeeklyReports.sort((a, b) => b.data.date.localeCompare(a.data.date))[0];

function formatWeekRange(fridayStr: string) {
  const friday = new Date(fridayStr + 'T00:00:00');
  const monday = new Date(friday);
  monday.setDate(friday.getDate() - 4);
  return {
    start: `${monday.getFullYear()}년 ${monday.getMonth() + 1}월 ${monday.getDate()}일`,
    end: `${friday.getMonth() + 1}월 ${friday.getDate()}일`,
  };
}

const allPosts = await getCollection('posts', ({ data }) => data.published !== false);
const posts = allPosts.sort((a, b) => {
  const dateComp = b.data.date.localeCompare(a.data.date);
  if (dateComp !== 0) return dateComp;
  const aOrder = a.data.order ?? 999;
  const bOrder = b.data.order ?? 999;
  return bOrder - aOrder;
});
const showOrder = ['12시에 만나요', '삼프로TV', '한국경제TV', '연합뉴스경제TV'];
const existingShows = new Set(posts.map(p => p.data.show));
const shows = ['전체', ...showOrder.filter(s => existingShows.has(s))];

// 날짜별 리포트 맵
const allReports = await getCollection('reports');
const reportsByDate: Record<string, typeof allReports[0]> = {};
for (const r of allReports) {
  reportsByDate[r.data.date] = r;
}

const days = ['일', '월', '화', '수', '목', '금', '토'];
function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 (${days[d.getDay()]})`;
}

// 날짜별로 그룹핑
const groupedPosts: Record<string, typeof posts> = {};
for (const post of posts) {
  const d = post.data.date;
  if (!groupedPosts[d]) groupedPosts[d] = [];
  groupedPosts[d].push(post);
}
// 포스트 날짜 + 리포트 날짜를 합쳐서 정렬
const allDates = [...new Set([...Object.keys(groupedPosts), ...Object.keys(reportsByDate)])];
const sortedDates = allDates.sort((a, b) => b.localeCompare(a));
---
<Base title="피드">
  <div class="feed-wrap">
    <div class="feed-header">
      <h1 class="feed-heading">오늘의 주식 방송 PICK</h1>
      <p class="feed-sub">방송마다 흩어진 종목·섹터·시장 이슈를 쉽게 정리해드려요.</p>
    </div>
    <div class="feed-filters">
      {shows.map(s => (
        <button class={`filter-btn ${s === '전체' ? 'active' : ''}`} data-show={s}>
          {s}
        </button>
      ))}
    </div>

    <div id="post-list">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p class="empty-icon">📭</p>
          <p class="empty-title">아직 작성된 글이 없어요</p>
          <p class="empty-desc">글 관리에서 새 글을 작성해보세요.</p>
          <a href="/editor" class="btn-pill primary" style="margin-top: 16px;">글 작성하러 가기</a>
        </div>
      ) : sortedDates.map(date => (
        <>
          {latestWeekly && date === latestWeekly.data.date && (() => {
            const range = formatWeekRange(latestWeekly.data.date);
            return (
              <>
                <div class="date-divider date-divider--weekly">
                  <span class="date-divider-label">{range.start} ~ {range.end}</span>
                </div>
                <a href={`/weekly/${latestWeekly.data.date}`} class="weekly-card">
                  <div class="weekly-card-label">PICK 주간 리포트</div>
                  <div class="weekly-card-headline">{latestWeekly.data.headline}</div>
                </a>
              </>
            );
          })()}
          <div class="date-divider" data-date={date}>
            <span class="date-divider-label">{formatDate(date)}</span>
          </div>
          {reportsByDate[date] && (
            <a href={`/report/${date}`} class="report-card" data-date={date}>
              <div class="report-card-label">PICK 리포트</div>
              <div class="report-card-headline">{reportsByDate[date].data.headline}</div>
            </a>
          )}
          {(groupedPosts[date] ?? []).map(post => {
            const { title, show, summary } = post.data;
            return (
              <a href={`/post/${post.id}`} class="post-card" data-show={show} data-date={date}>
                <div class="card-meta">
                  <span class="card-show">{show}</span>
                  <span class="card-dot"></span>
                  <span class="card-date" data-date={date}>날짜</span>
                </div>
                <h2 class="card-title">{title}</h2>
                <p class="card-summary">{summary}</p>
                <div class="card-cta">3분 요약 보기 →</div>
              </a>
            );
          })}
        </>
      ))}
    </div>
  </div>
</Base>

<style>
  .feed-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }

  .feed-header {
    padding: 16px 0 24px;
  }
  .feed-heading {
    font-size: 22px; font-weight: 800; letter-spacing: -0.02em;
    color: var(--text-1); margin-bottom: 6px;
  }
  .feed-sub {
    font-size: 14px; color: var(--text-3); line-height: 1.5;
  }

  .feed-filters {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
    margin-bottom: 20px;
  }
  .feed-filters::-webkit-scrollbar { display: none; }

  .filter-btn {
    padding: 8px 16px; border-radius: 20px; font-size: 14px; font-weight: 600;
    color: var(--text-2); background: var(--card); border: 1px solid var(--border);
    transition: all 140ms ease; cursor: pointer; white-space: nowrap; flex-shrink: 0;
  }
  .filter-btn.active, .filter-btn:hover { background: #111; color: #fff; border-color: #111; }

  .empty-state {
    display: flex; flex-direction: column; align-items: center;
    padding: 80px 24px; text-align: center;
  }
  .empty-icon { font-size: 48px; margin-bottom: 16px; }
  .empty-title { font-size: 18px; font-weight: 700; color: var(--text-1); margin-bottom: 8px; }
  .empty-desc { font-size: 14px; color: var(--text-3); }

  .date-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 24px 0 12px;
  }
  .date-divider::before,
  .date-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .date-divider-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-3);
    white-space: nowrap;
  }

  /* 주간 리포트 카드 */
  .weekly-card {
    display: block;
    background: #1a2540;
    border: 1.5px solid #2d3a5a;
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 10px;
    text-decoration: none;
    transition: opacity 160ms ease;
  }
  .weekly-card:hover { opacity: 0.88; }
  .weekly-card-label {
    font-size: 13px;
    font-weight: 700;
    color: #ed781f;
    letter-spacing: 0.01em;
    margin-bottom: 8px;
  }
  .weekly-card-headline {
    font-size: 18px;
    font-weight: 800;
    color: #fff;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  /* 리포트 카드 */
  .report-card {
    display: block;
    background: linear-gradient(135deg, #191f28 0%, #2d3748 100%);
    border-radius: 16px;
    padding: 14px 20px;
    margin-bottom: 10px;
    text-decoration: none;
    color: #fff;
    transition: opacity 160ms ease;
  }
  .report-card:hover { opacity: 0.9; }
  .report-card-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 6px;
    letter-spacing: 0.01em;
  }
  .report-card-headline {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  .report-card-meta {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
  }

  .card-cta {
    text-align: right;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
    margin-top: 12px;
  }

  .date-divider--weekly::before,
  .date-divider--weekly::after { background: #b0b8c1; }
  .date-divider--weekly .date-divider-label {
    font-size: 12px;
    font-weight: 700;
    color: #4e5968;
  }

  .date-divider--today {
    margin-top: 4px;
    justify-content: center;
  }
  .date-divider--today::before,
  .date-divider--today::after {
    display: none;
  }
  .date-divider--today .date-divider-label {
    font-size: 13px;
    font-weight: 800;
    color: #ed781f;
    background: color-mix(in srgb, #ed781f 12%, transparent);
    padding: 5px 14px;
    border-radius: 20px;
    letter-spacing: -0.01em;
  }
</style>

<script>
  // ── 날짜 표시 ──────────────────────────────────────────
  function formatRelativeDate(dateStr: string): string {
    const today = new Date();
    const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
    if (dateStr === todayStr) return '오늘';
    const d = new Date(dateStr + 'T00:00:00');
    return `${d.getMonth() + 1}월 ${d.getDate()}일`;
  }

  document.querySelectorAll<HTMLElement>('.card-date[data-date]').forEach(el => {
    const date = el.dataset.date!;
    el.textContent = formatRelativeDate(date);
  });

  // 날짜 구분선도 오늘이면 숨기고 카드에 오늘 표시로 처리
  document.querySelectorAll<HTMLElement>('.date-divider[data-date]').forEach(el => {
    const date = el.dataset.date!;
    const today = new Date();
    const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
    if (date === todayStr) {
      el.classList.add('date-divider--today');
      const label = el.querySelector('.date-divider-label');
      if (label) label.textContent = '오늘의 PICK';
    }
  });

  // ── 필터 ──────────────────────────────────────────────
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const show = btn.dataset.show;

      cards.forEach(card => {
        card.style.display = (show === '전체' || card.dataset.show === show) ? '' : 'none';
      });

      // 날짜 구분선: 해당 날짜 아래 보이는 카드가 없으면 구분선도 숨김
      document.querySelectorAll<HTMLElement>('.date-divider').forEach(divider => {
        const date = divider.dataset.date;
        const hasVisible = [...cards].some(c => c.dataset.date === date && c.style.display !== 'none');
        divider.style.display = hasVisible ? '' : 'none';
      });
    });
  });
</script>
