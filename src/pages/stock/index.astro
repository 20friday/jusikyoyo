---
import Base from '../../layouts/Base.astro';

// 모든 데이터를 클라이언트에서 API로 로드 (Vercel CDN 캐시 우회)
const initialData = '[]';
const initialWeekData = '[]';
const initialMonthData = '[]';
---

<Base title="종목 랭킹">
  <div class="feed-wrap">

    <!-- 페이지 인트로 -->
    <div class="rank-header">
      <h1 class="rank-h1">🔥 오늘의 PICK 종목</h1>
      <p class="rank-sub">오늘 시장에서 반복적으로 언급된 종목을 순위로 정리했어요.</p>
    </div>

    <!-- 기간 탭 -->
    <div class="period-tabs" id="periodTabs">
      <button class="period-tab active" data-period="day">일간</button>
      <button class="period-tab" data-period="week">주간</button>
      <button class="period-tab" data-period="month">월간</button>
    </div>

    <!-- 메타 행 -->
    <div class="rank-meta-row">
      <span class="rank-meta-date" id="metaDate"></span>
      <span class="rank-meta-ai"><span class="rank-meta-dot"></span>AI 자동 집계</span>
    </div>


    <!-- 랭킹 리스트 -->
    <ul class="rank-list" id="rankList"></ul>

    <!-- 비어있을 때 -->
    <div class="rank-empty" id="rankEmpty" hidden>
      <p>해당 기간의 데이터가 없어요.</p>
    </div>

    <!-- 고지문 -->
    <div class="rank-disclaimer">
      이 랭킹은 방송 언급 빈도·이슈 강도·주가 변동·지속성을 기반으로 AI가 자동 집계한 정보예요. 종목 추천이나 투자 권유가 아니에요. 투자 판단과 책임은 본인에게 있어요.
    </div>

  </div>
</Base>

<style is:global>
  .feed-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }

  /* ── 페이지 인트로 ── */
  .rank-header { margin-bottom: 20px; }
  .rank-h1 {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 6px;
  }
  .rank-sub {
    font-size: 15px;
    color: var(--text-3);
    line-height: 1.5;
  }

  /* ── 기간 탭 ── */
  .period-tabs {
    display: flex;
    background: var(--border);
    border-radius: 11px;
    padding: 3px;
    gap: 0;
    margin-bottom: 14px;
  }
  .period-tab {
    flex: 1;
    padding: 8px 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-3);
    border-radius: 8px;
    transition: color 160ms ease;
    letter-spacing: -0.01em;
  }
  .period-tab.active {
    background: #fff;
    color: var(--text-1);
    font-weight: 800;
    box-shadow: 0 1px 4px rgba(0,0,0,0.10), 0 0px 1px rgba(0,0,0,0.06);
  }

  /* ── 메타 행 ── */
  .rank-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    font-size: 13px;
  }
  .rank-meta-date { color: var(--text-2); font-weight: 700; }
  .rank-meta-ai { display: flex; align-items: center; gap: 5px; color: var(--text-3); font-weight: 600; }
  .rank-meta-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--blue); display: inline-block;
  }

  /* ── 랭킹 리스트 ── */
  .rank-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; }

  /* ── 랭킹 카드 ── */
  .rank-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 15px;
    overflow: hidden;
    transition: box-shadow 200ms ease, transform 200ms ease, border-color 200ms ease;
    width: 100%;
  }
  .rank-card--open {
    box-shadow: 0 14px 36px -14px rgba(0,0,0,0.20), 0 2px 6px -2px rgba(0,0,0,0.05);
    border-color: var(--divider);
  }

  /* 카드 버튼 (헤더 부분) */
  .rank-card-btn {
    width: 100%;
    display: flex;
    align-items: center;
    text-align: left;
    border-radius: 0;
  }

  /* 좌측 레일 */
  .rank-rail {
    width: 50px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 15px 0 15px 6px;
    gap: 4px;
  }
  .rank-num {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--text-1);
  }
  .rank-card--top3 .rank-num { color: #ed781f; }

  /* 이동 배지 */
  .rank-move {
    font-size: 14px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .rank-move--up { color: var(--up); }
  .rank-move--down { color: var(--down); }
  .rank-move--same { color: var(--text-3); }
  .rank-move--new, .rank-move--re {
    font-size: 10px;
    font-weight: 800;
    padding: 3px 6px;
    border-radius: 5px;
    white-space: nowrap;
  }
  .rank-move--new { background: #ed781f; color: #fff; }
  .rank-move--re { background: rgba(124,92,255,0.12); color: #7c5cff; }

  /* 카드 바디 */
  .rank-body {
    flex: 1;
    padding: 14px 14px 14px 9px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rank-info { flex: 1; min-width: 0; }
  .rank-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
    flex-wrap: wrap;
  }
  .rank-name {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-1);
  }
  .rank-status {
    font-size: 14px;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 6px;
  }
  .rank-status--pos { background: var(--up-bg); color: var(--up); }
  .rank-status--neu { background: var(--flat-bg); color: var(--text-3); }
  .rank-status--warn { background: var(--down-bg); color: var(--down); }
  .rank-status--loading { background: #f0f2f4; color: #94a0ad; }
  .rank-status--mention { background: #f0f2f4; color: #8b95a1; }
  .rank-intensity {
    display: none;
  }

  .rank-status-reason {
    font-size: 13px;
    color: var(--text-3);
    font-weight: 500;
    line-height: 1.4;
    margin-top: 3px;
    display: block;
  }
  .rank-stat-row {
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .rank-change-pct { font-weight: 800; font-variant-numeric: tabular-nums; }
  .rank-change-pct--up { color: var(--up); }
  .rank-change-pct--down { color: var(--down); }
  .rank-change-pct--flat { color: var(--flat); }
  .rank-sep { width: 2.5px; height: 2.5px; border-radius: 50%; background: var(--text-3); flex-shrink: 0; }
  .rank-hold { color: var(--text-3); font-size: 14px; }

  /* 관심 강도 점수 */
  .rank-score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 2px;
  }
  .rank-score-num {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--text-1);
  }
  .rank-score-suffix { font-size: 14px; font-weight: 400; color: var(--text-3); }
  .rank-score-label {
    font-size: 14px;
    color: var(--text-3);
  }
  @media (max-width: 380px) { .rank-score-label { display: none; } }

  /* 셰브론 */
  .rank-chevron {
    flex-shrink: 0;
    color: var(--text-3);
    opacity: 0.6;
    transition: transform 240ms cubic-bezier(0.2,0.7,0.3,1);
  }
  .rank-card--open .rank-chevron { transform: rotate(180deg); }

  /* ── 카드 펼침 상세 ── */
  .rank-detail { border-top: 1px solid var(--border); }
  .rank-detail-inner { padding: 0 16px; }
  .detail-sec {
    padding: 17px 0;
    border-top: 1px solid var(--border);
  }
  .detail-sec:first-child { border-top: none; }

  .rank-detail-lead {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-1);
  }

  .detail-block-label {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-3);
    margin-bottom: 6px;
  }
  .rank-chart-caption {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .rank-chart-caption b { color: #ed781f; }
  .rank-chart { width: 100%; display: block; }

  /* 주가 흐름 */
  .price-flow {
    display: flex;
    gap: 0;
  }
  .price-col {
    flex: 1;
    padding: 0 12px;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .price-col:first-child { padding-left: 0; border-left: none; }
  .price-col-label { font-size: 14px; color: var(--text-3); }
  .price-val {
    font-size: 18px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .price-val--up { color: var(--up); }
  .price-val--down { color: var(--down); }
  .price-val--flat { color: var(--flat); }

  /* 요인 */
  .factor-group { display: flex; flex-direction: column; gap: 14px; }
  .factor-block { }
  .factor-head {
    font-size: 14px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .factor-dot {
    width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  }
  .factor-block--pos .factor-head { color: var(--up); }
  .factor-block--pos .factor-dot { background: var(--up); }
  .factor-block--warn .factor-head { color: var(--down); }
  .factor-block--warn .factor-dot { background: var(--down); }
  .factor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .factor-list li {
    font-size: 15px;
    color: var(--text-2);
    padding-left: 14px;
    position: relative;
    line-height: 1.5;
  }
  .factor-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  /* 방송 언급 히스토리 버튼 */
  .stock-history-btn {
    display: inline-block;
    margin-top: 14px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    background: var(--surface-2, rgba(255,255,255,0.06));
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
  }
  .stock-history-btn:hover {
    background: var(--surface-3, rgba(255,255,255,0.10));
  }

  /* 긍정/주의 이유 섹션 */
  .detail-sec--reason {
    background: var(--surface-2, rgba(0,0,0,0.03));
    border-radius: 10px;
    padding: 14px 16px;
    margin-top: 16px;
    margin-bottom: 16px;
  }
  .detail-reason-title {
    font-size: 13px;
    font-weight: 800;
    color: var(--accent, #e86c2c);
    margin-bottom: 6px;
  }
  .detail-reason-body {
    font-size: 15px;
    color: var(--text-1);
    line-height: 1.55;
    margin: 0;
  }

  /* 왜 순위에 올랐나요 */
  .basis-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    margin-bottom: 8px;
  }
  .basis-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .basis-list li {
    font-size: 15px;
    color: var(--text-2);
    padding-left: 14px;
    position: relative;
    line-height: 1.5;
  }
  .basis-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #ed781f;
  }

  /* ── 비어있을 때 ── */
  .rank-empty {
    text-align: center;
    padding: 40px 0;
    color: var(--text-3);
    font-size: 15px;
  }

  /* ── 고지문 ── */
  .rank-disclaimer {
    margin-top: 24px;
    padding: 14px 16px;
    background: var(--border);
    border-radius: 12px;
    font-size: 13px;
    color: var(--text-3);
    line-height: 1.6;
  }
</style>

