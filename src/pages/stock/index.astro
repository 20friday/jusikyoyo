    move: { type: 'down', n: 3 }, score: 55, todayPct: -2.4, hold: '오늘 진입',
    reason: '양극재 업황 부진 우려로 <b>관심이 약해지는</b> 흐름이에요.',
    rankTrail: [4, 6, 6, 6, 8, 6, 9],
    price: { today: -2.4, d5: -6.8, m1: -14.3 },
    factorsPos: ['2차전지 반등 시 탄력 기대'],
    factorsWarn: ['양극재 가동률 하락', '전기차 수요 둔화 직격', '재고 부담 지속'],
    basis: ['2개 방송에서 우려와 함께 언급', '2차전지 약세 흐름 코멘트', '저점 논쟁 등장'],
  },
  {
    rank: 10, name: '현대차', cap: 'large', status: 'neu',
