---
import Base from '../layouts/Base.astro';

if (Astro.locals.session) {
  return Astro.redirect('/');
}

let errorMessage = '';
let sentEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  const tos_age = form.get('tos_age');
  const tos1 = form.get('tos1');
  const tos2 = form.get('tos2');
  const tos_marketing = form.get('tos_marketing');

  // 닉네임 서버에서 자동 생성
  const adjs  = ['냉철한','신중한','날카로운','대담한','현명한','꼼꼼한','침착한','용감한','느긋한','영리한','집요한','유연한'];
  const nouns = ['고래','황소','부엉이','여우','독수리','곰돌이','늑대','토끼','사자','판다','다람쥐','펭귄'];
  const adj   = adjs[Math.floor(Math.random() * adjs.length)];
  const noun  = nouns[Math.floor(Math.random() * nouns.length)];
  const num   = Math.floor(1000 + Math.random() * 9000);
  const nickname = `${adj}_${noun}${num}`;

  if (!tos_age || !tos1 || !tos2) {
    errorMessage = '필수 항목에 모두 동의해 주세요.';
  } else if (password.length < 8) {
    errorMessage = '비밀번호는 8자 이상이어야 해요.';
  } else if (password !== confirm) {
    errorMessage = '비밀번호가 일치하지 않아요.';
  } else {
    const { error } = await Astro.locals.supabase.auth.signUp({
      email,
      password,
      options: { data: { nickname, marketing: !!tos_marketing } },
    });
    if (error) {
      errorMessage = error.message.includes('already registered')
        ? '이미 가입된 이메일이에요. 로그인해주세요.'
        : '가입에 실패했어요. 다시 시도해주세요.';
    } else {
      sentEmail = email;
    }
  }
}
---
<Base title="회원가입 — 테드픽">
  <div class="auth-page">
    <div class="auth-inner">

      {sentEmail ? (
        <div class="sent-state">
          <div class="sent-icon">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none">
              <path d="M6 20l9 9L34 10" stroke="var(--blue)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h1 class="auth-h1">메일을 보냈어요</h1>
          <p class="auth-sub">
            <strong>{sentEmail}</strong>로<br/>인증 링크를 보냈어요.<br/><br/>
            메일함을 확인하고 링크를 클릭하면<br/>가입이 완료돼요.<br/>
            스팸함도 꼭 확인해 주세요.
          </p>
          <a href="/login" class="btn-auth-primary" style="text-decoration:none; margin-top: 40px;">
            로그인하러 가기
          </a>
        </div>
      ) : (
      <>
      <div class="auth-top">
        <h1 class="auth-h1">이메일로<br/>가입하기</h1>
        <p class="auth-sub">가입 즉시 3일 무료 체험이 시작돼요.</p>
      </div>

      {errorMessage && (
        <div class="auth-error">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6"/>
            <path d="M10 6v4.5M10 13.2v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          {errorMessage}
        </div>
      )}

      <form method="POST" class="auth-form">
        <div class="field">
          <label class="field-label" for="email">이메일</label>
          <input class="field-input" id="email" type="email" name="email" required autocomplete="email" placeholder="ted@example.com" />
          <span class="field-hint">리포트 알림과 로그인에 사용할 이메일이에요</span>
        </div>

        <div class="field">
          <label class="field-label" for="password">비밀번호</label>
          <div class="field-pw-wrap">
            <input class="field-input" id="password" type="password" name="password" required autocomplete="new-password" minlength="8" placeholder="8자 이상" />
            <button type="button" class="pw-toggle" id="pw-toggle" aria-label="비밀번호 보기">
              <svg id="eye-show" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M3 10s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="10" cy="10" r="2.2" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <svg id="eye-hide" width="20" height="20" viewBox="0 0 20 20" fill="none" style="display:none">
                <path d="M3 10s2.5-5 7-5c1.4 0 2.6.5 3.6 1.2M17 10s-2.5 5-7 5c-1.4 0-2.6-.5-3.6-1.2M3 3l14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <span class="field-hint">영문·숫자 포함 8자 이상</span>
        </div>

        <div class="field">
          <label class="field-label" for="confirm">비밀번호 확인</label>
          <input class="field-input" id="confirm" type="password" name="confirm" required autocomplete="new-password" placeholder="비밀번호 재입력" />
        </div>


        <div class="auth-spacer"></div>

        <div class="tos-section">
          <!-- 전체 동의 -->
          <div class="tos-all-box" id="tos-all-wrap">
            <span class="tos-circle-all" id="tos-all-box"></span>
            <input type="checkbox" id="tos-all" style="display:none" />
            <span class="tos-all-label">전체 동의 <span class="tos-all-sub">(선택 포함)</span></span>
          </div>

          <!-- 개별 항목 -->
          <div class="tos-list">
            <!-- 만 14세 -->
            <div class="tos-item" id="tos-age-row">
              <span class="tos-circle" id="tos-age-box"></span>
              <input type="checkbox" id="tos_age" name="tos_age" style="display:none" />
              <span class="tos-item-text">
                <span class="badge req">[필수]</span> 만 14세 이상입니다
              </span>
            </div>

            <!-- 이용약관 -->
            <div class="tos-item" id="tos1-row">
              <span class="tos-circle" id="tos1-box"></span>
              <input type="checkbox" id="tos1" name="tos1" style="display:none" />
              <span class="tos-item-text">
                <span class="badge req">[필수]</span> 이용약관 동의
              </span>
              <a href="/terms" target="_blank" class="tos-chevron" aria-label="이용약관 보기">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>

            <!-- 개인정보 수집·이용 -->
            <div class="tos-item" id="tos2-row">
              <span class="tos-circle" id="tos2-box"></span>
              <input type="checkbox" id="tos2" name="tos2" style="display:none" />
              <span class="tos-item-text">
                <span class="badge req">[필수]</span> 개인정보 수집·이용 동의
              </span>
              <a href="/privacy" target="_blank" class="tos-chevron" aria-label="개인정보 수집·이용 내용 보기">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>

            <!-- 마케팅 (선택) -->
            <div class="tos-item" id="tos-mkt-row">
              <span class="tos-circle" id="tos-mkt-box"></span>
              <input type="checkbox" id="tos_marketing" name="tos_marketing" style="display:none" />
              <span class="tos-item-text">
                <span class="badge opt">[선택]</span> 마케팅 정보 수신 동의
              </span>
              <a href="/marketing" target="_blank" class="tos-chevron" aria-label="마케팅 정보 수신 동의 보기">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <p class="tos-footer-note">선택 항목에 동의하지 않아도 테드픽을 이용할 수 있어요.</p>
        </div>

        <button class="btn-auth-primary" type="submit" id="submit-btn" disabled>가입하기</button>
      </form>

      <p class="auth-switch">이미 가입했어요? <a href="/login">로그인</a></p>
      </>
      )}

    </div>
  </div>
</Base>

<style>
  .auth-page {
    min-height: calc(100svh - 57px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 24px 32px;
  }
  .auth-inner {
    width: 100%;
    max-width: 390px;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 40px;
  }

  .auth-top { margin-bottom: 32px; }
  .auth-h1 {
    font-size: 28px;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 8px;
  }
  .auth-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--up);
    background: var(--up-bg);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 20px;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }
  .field-input {
    height: 52px;
    border-radius: 12px;
    border: 1.5px solid var(--divider);
    background: var(--card);
    padding: 0 16px;
    font-family: var(--font);
    font-size: 16px;
    color: var(--text-1);
    letter-spacing: -0.01em;
    outline: none;
    transition: border-color 140ms, background 140ms;
    width: 100%;
  }
  .field-input::placeholder { color: var(--text-3); }
  .field-input:focus { border-color: var(--blue); background: #fff; }
  .field-hint {
    font-size: 12px;
    color: var(--text-3);
    margin-top: 2px;
  }
  .field-hint.ok  { color: #38a169; }
  .field-hint.err { color: var(--up); }

  .field-input.ok  { border-color: #38a169; }
  .field-input.err { border-color: var(--up); }

  .field-pw-wrap { position: relative; }
  .field-pw-wrap .field-input { padding-right: 48px; }
  .pw-toggle {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    padding: 4px;
    color: var(--text-3);
    display: flex;
    align-items: center;
  }

  .auth-spacer { flex: 1; min-height: 24px; }

  /* 약관 섹션 */
  .tos-section {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 4px;
  }

  /* 전체 동의 박스 */
  .tos-all-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border: 1.8px solid var(--blue);
    border-radius: 14px;
    background: color-mix(in srgb, var(--blue) 8%, transparent);
    cursor: pointer;
    margin-bottom: 6px;
    user-select: none;
  }
  .tos-circle-all {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.8px solid var(--divider);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--bg);
    transition: background 140ms, border-color 140ms;
  }
  .tos-circle-all.checked {
    background: var(--blue);
    border-color: var(--blue);
  }
  .tos-circle-all.checked::after {
    content: '';
    display: block;
    width: 11px;
    height: 6.5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: translateY(-1.5px) rotate(-45deg);
  }
  .tos-all-label {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-1);
    letter-spacing: -0.01em;
  }
  .tos-all-sub {
    font-weight: 500;
    color: var(--text-3);
  }

  /* 개별 항목 리스트 */
  .tos-list {
    display: flex;
    flex-direction: column;
    padding: 4px 2px;
  }
  .tos-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 4px;
    cursor: pointer;
    user-select: none;
    border-bottom: 1px solid var(--divider);
  }
  .tos-item:last-child { border-bottom: none; }

  .tos-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.8px solid var(--divider);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--bg);
    transition: background 140ms, border-color 140ms;
  }
  .tos-circle.checked {
    background: var(--text-1);
    border-color: var(--text-1);
  }
  .tos-circle.checked::after {
    content: '';
    display: block;
    width: 11px;
    height: 6.5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: translateY(-1.5px) rotate(-45deg);
  }

  .tos-item-text {
    flex: 1;
    font-size: 14px;
    color: var(--text-1);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .badge {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-right: 2px;
  }
  .badge.req { color: var(--blue); }
  .badge.opt { color: var(--text-3); }

  .tos-chevron {
    color: var(--text-3);
    display: flex;
    align-items: center;
    padding: 4px;
    flex-shrink: 0;
    margin-left: auto;
  }
  .tos-chevron:hover { color: var(--text-1); }

  .tos-footer-note {
    font-size: 12px;
    color: var(--text-3);
    margin-top: 10px;
    padding: 0 4px;
    line-height: 1.5;
  }

  .btn-auth-primary {
    width: 100%;
    height: 54px;
    border-radius: 14px;
    background: var(--blue);
    color: #fff;
    font-family: var(--font);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 140ms, transform 140ms;
    border: none;
    margin-bottom: 12px;
  }
  .btn-auth-primary:active { transform: scale(0.985); opacity: 0.9; }
  .btn-auth-primary:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }


  .auth-switch {
    text-align: center;
    font-size: 14px;
    color: var(--text-3);
  }
  .auth-switch a {
    color: var(--blue);
    font-weight: 700;
    margin-left: 4px;
  }
  .auth-switch a:hover { text-decoration: underline; }

  .sent-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 60px;
  }
  .sent-icon {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #fdf0e6;
    display: grid;
    place-items: center;
    margin-bottom: 24px;
  }
  .sent-state .auth-h1 { text-align: center; margin-bottom: 14px; }
  .sent-state .auth-sub { text-align: center; }
  .sent-state strong { color: var(--text-1); font-weight: 700; }
</style>

<script>
  // 비밀번호 보기 토글
  const pwInput    = document.getElementById('password') as HTMLInputElement;
  const toggle     = document.getElementById('pw-toggle');
  const eyeShow    = document.getElementById('eye-show');
  const eyeHide    = document.getElementById('eye-hide');
  toggle?.addEventListener('click', () => {
    const isText = pwInput.type === 'text';
    pwInput.type = isText ? 'password' : 'text';
    eyeShow!.style.display = isText ? '' : 'none';
    eyeHide!.style.display = isText ? 'none' : '';
  });

  // 헬퍼: 힌트 상태 변경
  function setHint(input: HTMLInputElement, hint: HTMLElement | null, state: 'ok'|'err'|'idle', msg: string) {
    input.classList.remove('ok','err');
    if (hint) { hint.classList.remove('ok','err'); hint.textContent = msg; }
    if (state !== 'idle') { input.classList.add(state); hint?.classList.add(state); }
  }

  // 이메일
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const emailHint  = emailInput.nextElementSibling as HTMLElement;
  emailInput.addEventListener('input', () => {
    if (!emailInput.value) { setHint(emailInput, emailHint, 'idle', '리포트 알림과 로그인에 사용할 이메일이에요'); return; }
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value);
    setHint(emailInput, emailHint, ok ? 'ok' : 'err', ok ? '올바른 이메일이에요' : '이메일 형식을 확인해 주세요');
  });

  // 비밀번호
  const pwHint = pwInput.closest('.field')!.querySelector('.field-hint') as HTMLElement;
  pwInput.addEventListener('input', () => {
    if (!pwInput.value) { setHint(pwInput, pwHint, 'idle', '영문·숫자 포함 8자 이상'); checkConfirm(); return; }
    const hasLetter = /[a-zA-Z]/.test(pwInput.value);
    const hasNum    = /[0-9]/.test(pwInput.value);
    const long      = pwInput.value.length >= 8;
    const ok = hasLetter && hasNum && long;
    let msg = '';
    if (!long)          msg = `${pwInput.value.length}/8자 — 더 입력해 주세요`;
    else if (!hasLetter) msg = '영문자를 포함해 주세요';
    else if (!hasNum)    msg = '숫자를 포함해 주세요';
    else                 msg = '좋은 비밀번호예요 ✓';
    setHint(pwInput, pwHint, ok ? 'ok' : 'err', msg);
    checkConfirm();
  });

  // 비밀번호 확인
  const confirmInput = document.getElementById('confirm') as HTMLInputElement;
  function checkConfirm() {
    if (!confirmInput.value) { setHint(confirmInput, null, 'idle', ''); return; }
    const ok = confirmInput.value === pwInput.value;
    setHint(confirmInput, null, ok ? 'ok' : 'err', '');
  }
  confirmInput.addEventListener('input', checkConfirm);


  // 약관 동의
  const allWrap  = document.getElementById('tos-all-wrap')!;
  const allBox   = document.getElementById('tos-all-box')!;
  const allCheck = document.getElementById('tos-all') as HTMLInputElement;

  const ageBox   = document.getElementById('tos-age-box')!;
  const ageRow   = document.getElementById('tos-age-row')!;
  const ageInput = document.getElementById('tos_age') as HTMLInputElement;

  const tos1Box  = document.getElementById('tos1-box')!;
  const tos1Row  = document.getElementById('tos1-row')!;
  const tos1     = document.getElementById('tos1') as HTMLInputElement;

  const tos2Box  = document.getElementById('tos2-box')!;
  const tos2Row  = document.getElementById('tos2-row')!;
  const tos2     = document.getElementById('tos2') as HTMLInputElement;

  const mktBox   = document.getElementById('tos-mkt-box')!;
  const mktRow   = document.getElementById('tos-mkt-row')!;
  const mktInput = document.getElementById('tos_marketing') as HTMLInputElement;

  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  function setCheck(box: Element, input: HTMLInputElement, val: boolean) {
    input.checked = val;
    box.classList.toggle('checked', val);
  }

  function syncState() {
    const allRequired = ageInput.checked && tos1.checked && tos2.checked;
    const allItems = allRequired && mktInput.checked;
    setCheck(allBox, allCheck, allItems);
    submitBtn.disabled = !allRequired;
  }

  // 전체 동의 클릭
  allWrap.addEventListener('click', () => {
    const next = !allCheck.checked;
    setCheck(allBox, allCheck, next);
    setCheck(ageBox, ageInput, next);
    setCheck(tos1Box, tos1, next);
    setCheck(tos2Box, tos2, next);
    setCheck(mktBox, mktInput, next);
    submitBtn.disabled = !next;
  });

  // 개별 항목 클릭 (chevron 링크 제외)
  function addItemToggle(row: Element, box: Element, input: HTMLInputElement) {
    row.addEventListener('click', (e) => {
      if ((e.target as Element).closest('.tos-chevron')) return;
      setCheck(box, input, !input.checked);
      syncState();
    });
  }

  addItemToggle(ageRow, ageBox, ageInput);
  addItemToggle(tos1Row, tos1Box, tos1);
  addItemToggle(tos2Row, tos2Box, tos2);
  addItemToggle(mktRow, mktBox, mktInput);
</script>
