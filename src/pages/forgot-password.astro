---
import Base from '../layouts/Base.astro';

if (Astro.locals.session) {
  return Astro.redirect('/');
}

let sent = false;
let errorMessage = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '');

  const { error } = await Astro.locals.supabase.auth.resetPasswordForEmail(email, {
    redirectTo: `${Astro.url.origin}/reset-password`,
  });

  if (error) {
    errorMessage = '메일 발송에 실패했어요. 다시 시도해주세요.';
  } else {
    sent = true;
  }
}
---
<Base title="비밀번호 찾기 — 테드픽">
  <div class="auth-page">
    <div class="auth-inner">

      {sent ? (
        <div class="sent-state">
          <div class="sent-icon">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none">
              <path d="m10 21 7 7 14-16" stroke="var(--blue)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h1 class="auth-h1">메일을 보냈어요</h1>
          <p class="auth-sub">
            입력하신 이메일 주소로<br/>비밀번호 재설정 링크를 보냈어요.<br/>메일이 안 오면 스팸함도 확인해 주세요.
          </p>
          <a href="/login" class="btn-auth-primary" style="text-decoration:none; margin-top: 40px;">
            로그인으로 돌아가기
          </a>
        </div>
      ) : (
        <>
          <div class="auth-top">
            <a href="/login" class="back-btn">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                <path d="m13 5-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <h1 class="auth-h1">비밀번호를<br/>잊으셨나요?</h1>
            <p class="auth-sub">가입한 이메일을 알려주시면<br/>재설정 링크를 보내드려요.</p>
          </div>

          {errorMessage && (
            <div class="auth-error">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6"/>
                <path d="M10 6v4.5M10 13.2v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              {errorMessage}
            </div>
          )}

          <form method="POST" class="auth-form">
            <div class="field">
              <label class="field-label" for="email">이메일</label>
              <input class="field-input" id="email" type="email" name="email" required autocomplete="email" placeholder="가입한 이메일 주소" />
            </div>

            <div class="auth-spacer"></div>

            <button class="btn-auth-primary" type="submit">재설정 링크 받기</button>
          </form>
        </>
      )}

    </div>
  </div>
</Base>

<style>
  .auth-page {
    min-height: calc(100svh - 57px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 24px 32px;
  }
  .auth-inner {
    width: 100%;
    max-width: 390px;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 40px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    color: var(--text-3);
    margin-bottom: 20px;
  }
  .back-btn:hover { color: var(--text-1); }

  .auth-top { margin-bottom: 32px; }
  .auth-h1 {
    font-size: 28px;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: 8px;
  }
  .auth-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-2);
  }

  .auth-error {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--up);
    background: var(--up-bg);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 20px;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }
  .field-input {
    height: 52px;
    border-radius: 12px;
    border: 1.5px solid var(--divider);
    background: var(--card);
    padding: 0 16px;
    font-family: var(--font);
    font-size: 16px;
    color: var(--text-1);
    letter-spacing: -0.01em;
    outline: none;
    transition: border-color 140ms, background 140ms;
    width: 100%;
  }
  .field-input::placeholder { color: var(--text-3); }
  .field-input:focus { border-color: var(--blue); background: #fff; }

  .auth-spacer { flex: 1; min-height: 24px; }

  .btn-auth-primary {
    width: 100%;
    height: 54px;
    border-radius: 14px;
    background: var(--blue);
    color: #fff;
    font-family: var(--font);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 140ms, transform 140ms;
    border: none;
  }
  .btn-auth-primary:active { transform: scale(0.985); opacity: 0.9; }

  /* Sent state */
  .sent-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 80px;
  }
  .sent-icon {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #fdf0e6;
    display: grid;
    place-items: center;
    margin-bottom: 24px;
  }
</style>
