---
import Base from '../../layouts/Base.astro';

const { data: notices } = await Astro.locals.supabase
  .from('notices')
  .select('id, title, created_at')
  .eq('is_published', true)
  .order('created_at', { ascending: false });

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
}
---

<Base title="공지사항 — 테드픽">
  <div class="notice-wrap">
    <div class="notice-header">
      <h1 class="notice-title">공지사항</h1>
    </div>

    {!notices || notices.length === 0 ? (
      <div class="empty">
        <p class="empty-icon">📭</p>
        <p class="empty-text">아직 공지사항이 없어요</p>
      </div>
    ) : (
      <ul class="notice-list">
        {notices.map(n => (
          <li class="notice-item">
            <a href={`/notice/${n.id}`} class="notice-link">
              <span class="notice-item-title">{n.title}</span>
              <span class="notice-item-date">{formatDate(n.created_at)}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .notice-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px 16px 80px;
  }
  .notice-header {
    padding-bottom: 20px;
    border-bottom: 2px solid var(--text-1);
    margin-bottom: 0;
  }
  .notice-title {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-1);
    letter-spacing: -0.02em;
  }
  .notice-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .notice-item {
    border-bottom: 1px solid var(--border);
  }
  .notice-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 4px;
    text-decoration: none;
    transition: opacity 120ms;
  }
  .notice-link:hover { opacity: 0.65; }
  .notice-item-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-1);
    line-height: 1.5;
    flex: 1;
  }
  .notice-item-date {
    font-size: 13px;
    color: var(--text-3);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .empty {
    text-align: center;
    padding: 80px 0;
  }
  .empty-icon { font-size: 40px; margin-bottom: 12px; }
  .empty-text { font-size: 15px; color: var(--text-3); }
</style>
