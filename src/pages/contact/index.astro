---
import Base from '../../layouts/Base.astro';

if (!Astro.locals.session) {
  return Astro.redirect('/login?next=/contact');
}

const email = Astro.locals.user?.email ?? '';
---

<Base title="문의하기 — 테드픽">
  <div class="contact-wrap">
    <div class="contact-header">
      <h1 class="contact-title">문의하기</h1>
      <p class="contact-sub">궁금한 점이나 의견을 남겨주세요. 확인 후 이메일로 답변드려요.</p>
    </div>

    <div id="form-area">
      <form id="contact-form" class="contact-form">
        <div class="form-field">
          <label class="form-label">문의 유형</label>
          <select class="form-select" name="type" required>
            <option value="service">서비스 문의</option>
            <option value="content">콘텐츠 제안</option>
          </select>
        </div>
        <div class="form-field">
          <label class="form-label">이메일</label>
          <input class="form-input" type="text" value={email} readonly />
        </div>
        <div class="form-field">
          <label class="form-label">제목 <span class="required">*</span></label>
          <input class="form-input" type="text" name="title" placeholder="문의 제목을 입력해주세요" required />
        </div>
        <div class="form-field">
          <label class="form-label">내용 <span class="required">*</span></label>
          <textarea class="form-textarea" name="content" rows="6" placeholder="문의 내용을 자세히 적어주세요" required></textarea>
        </div>
        <div id="error-msg" class="form-error" style="display:none;"></div>
        <button type="submit" id="submit-btn" class="btn-submit">문의 보내기</button>
      </form>
    </div>

    <div id="done-area" style="display:none;" class="done-area">
      <div class="done-icon">✉️</div>
      <p class="done-title">문의가 접수됐어요</p>
      <p class="done-sub">이메일로 답변드릴게요.</p>
      <a href="/" class="btn-home">홈으로 →</a>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const formArea = document.getElementById('form-area') as HTMLDivElement;
  const doneArea = document.getElementById('done-area') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.textContent = '전송 중...';
    btn.disabled = true;
    errorMsg.style.display = 'none';

    const data = Object.fromEntries(new FormData(form));

    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });

    if (res.ok) {
      formArea.style.display = 'none';
      doneArea.style.display = 'block';
    } else {
      const msg = await res.text();
      errorMsg.textContent = msg || '오류가 발생했어요. 다시 시도해주세요.';
      errorMsg.style.display = 'block';
      btn.textContent = '문의 보내기';
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact-wrap { max-width: 560px; margin: 0 auto; padding: 40px 24px 80px; }
  .contact-header { margin-bottom: 28px; }
  .contact-title { font-size: 24px; font-weight: 800; color: var(--text-1); margin: 0 0 6px; }
  .contact-sub { font-size: 14px; color: var(--text-3); margin: 0; line-height: 1.6; }
  .contact-form { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-label { font-size: 13px; font-weight: 700; color: var(--text-2); }
  .required { color: #ef4444; }
  .form-input { height: 42px; border-radius: 8px; border: 1.5px solid var(--border); padding: 0 12px; font-size: 14px; color: var(--text-1); background: var(--card); outline: none; }
  .form-input[readonly] { background: var(--bg); color: var(--text-3); cursor: default; }
  .form-select { height: 42px; border-radius: 8px; border: 1.5px solid var(--border); padding: 0 12px; font-size: 14px; color: var(--text-1); background: var(--card); outline: none; cursor: pointer; }
  .form-select:focus, .form-input:focus { border-color: #ed781f; }
  .form-textarea { border-radius: 8px; border: 1.5px solid var(--border); padding: 10px 12px; font-size: 14px; color: var(--text-1); background: var(--card); outline: none; resize: vertical; line-height: 1.65; font-family: inherit; }
  .form-textarea:focus { border-color: #ed781f; }
  .form-error { background: #fee2e2; color: #dc2626; border-radius: 8px; padding: 10px 14px; font-size: 13px; }
  .btn-submit { height: 46px; background: #ed781f; color: #fff; border: none; border-radius: 10px; font-size: 15px; font-weight: 700; cursor: pointer; transition: opacity 120ms; }
  .btn-submit:hover { opacity: 0.88; }
  .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .done-area { text-align: center; padding: 60px 0; }
  .done-icon { font-size: 48px; margin-bottom: 16px; }
  .done-title { font-size: 20px; font-weight: 800; color: var(--text-1); margin: 0 0 8px; }
  .done-sub { font-size: 14px; color: var(--text-3); margin: 0 0 24px; }
  .btn-home { display: inline-block; padding: 10px 20px; background: #111; color: #fff; border-radius: 8px; font-size: 14px; font-weight: 700; text-decoration: none; }
</style>
