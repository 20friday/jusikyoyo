---
import Base from '../../layouts/Base.astro';

const { date } = Astro.params;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const { data: report } = await Astro.locals.supabase
  .from('daily_reports')
  .select('*')
  .eq('date', date)
  .single();

const days = ['일', '월', '화', '수', '목', '금', '토'];
function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일 ${days[d.getDay()]}요일`;
}

const comparisonsJson = report ? JSON.stringify(report.comparisons) : '[]';
const stocksJson = report ? JSON.stringify(report.stocks) : '[]';
---
<Base title="PICK 리포트" description="오늘 방송 교차분석 리포트">
  {!report ? (
    <div style="text-align:center;padding:80px 24px;color:var(--text-3);">
      <p style="font-size:32px;margin-bottom:12px;">📭</p>
      <p style="font-size:16px;font-weight:700;">리포트를 찾을 수 없어요</p>
    </div>
  ) : (
    <div class="report-wrap">

      <!-- 히어로 -->
      <div class="report-hero">
        <div class="report-hero-label"><span class="report-hero-label-pick">PICK 리포트</span> · {formatDate(report.date)}</div>
        <div class="report-hero-headline">{report.headline}</div>
      </div>

      <!-- 공통 언급 종목 -->
      <div class="report-section">
        <div class="report-section-label">공통 언급 종목</div>
        {report.stocks.map((stock: any, i: number) => (
          <button class="stock-row stock-row--clickable" data-stock={stock.name}>
            <div class="stock-row-left">
              <span class="stock-rank">#{i + 1}</span>
              <span class="stock-name">{stock.name}</span>
            </div>
            <div class="stock-row-right">
              <span class="stock-shows">{stock.shows.join(' · ')}</span>
              <span class="stock-row-chevron">›</span>
            </div>
          </button>
        ))}
      </div>

      <!-- 방송 간 의견 차이 -->
      <div class="report-section">
        <div class="report-section-label">방송 간 의견 차이</div>
        {report.comparisons.map((comp: any) => (
          <div style="margin-bottom:32px;">
            <div class="comparison-stock-title">{comp.stock}</div>
            {comp.points.map(pt => (
              <div class="comparison-point">
                <span class="comparison-point-show">{pt.show}:</span>{' '}{pt.view}
              </div>
            ))}
            <div class="comparison-pick">PICK: {comp.pick}</div>
          </div>
        ))}
      </div>

      <!-- 섹터 공통 흐름 -->
      <div class="report-section">
        <div class="report-section-label">섹터 공통 흐름</div>
        {report.sectors.map((sector: any) => (
          <div class="sector-row">
            <div class="sector-name">{sector.name}</div>
            <div class="sector-flow">{sector.flow}</div>
          </div>
        ))}
      </div>

      <!-- 오늘의 투자 인사이트 -->
      <div class="report-section">
        <div class="report-section-label">오늘의 투자 인사이트</div>
        <div class="report-insight">{report.insight}</div>
      </div>

    </div>
  )}

  <!-- 종목 모달 -->
  <div id="stock-modal-backdrop" class="stock-modal-backdrop"></div>
  <div id="stock-modal" class="stock-modal" aria-hidden="true" role="dialog">
    <div class="stock-modal-inner">
      <div id="stock-modal-content" class="stock-modal-content"></div>
      <button id="stock-modal-close" class="stock-modal-close" aria-label="닫기">닫기</button>
    </div>
  </div>
</Base>

<style>
.section-hint {
    font-size: 11px;
    font-weight: 400;
    color: var(--text-3);
    margin-left: 6px;
    letter-spacing: 0;
  }

  .stock-row--clickable {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .stock-row--clickable:active {
    opacity: 0.7;
  }

  .stock-row-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stock-row-chevron {
    font-size: 20px;
    color: var(--text-3);
    line-height: 1;
    flex-shrink: 0;
  }

  /* 모달 */
  .stock-modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 100;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .stock-modal-backdrop.open { display: block; }

  .stock-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 101;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }
  .stock-modal.open { display: flex; }

  .stock-modal-inner {
    background: var(--card);
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    animation: modal-in 220ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: scale(0.95); }
    to   { opacity: 1; transform: scale(1); }
  }

  .stock-modal-close {
    display: block;
    flex-shrink: 0;
    width: calc(100% - 40px);
    margin: 8px 20px 20px;
    padding: 16px;
    border-radius: 14px;
    background: var(--border);
    border: none;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    cursor: pointer;
    font-family: var(--font);
  }
  .stock-modal-close:active { background: var(--divider); }

  .stock-modal-content {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px 20px 8px;
  }

  .sheet-history {
    display: inline-block;
    margin-top: 16px;
    margin-bottom: 8px;
    padding: 10px 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
  }
  .sheet-history:hover { text-decoration: underline; }

</style>

<script define:vars={{ comparisonsJson, stocksJson }}>
  const comparisons = JSON.parse(comparisonsJson);
  const stocks = JSON.parse(stocksJson);
  const backdrop = document.getElementById('stock-modal-backdrop');
  const sheet = document.getElementById('stock-modal');
  const content = document.getElementById('stock-modal-content');

  function openSheet(stockName, shows) {
    const stockData = stocks.find(s => s.name === stockName);
    const notes = stockData?.notes ?? [];

    // 관련 comparison 찾기
    const related = comparisons.filter(c =>
      c.stock.includes(stockName) || stockName.includes(c.stock.split(' ')[0])
    );

    let html = `<div class="sheet-stock-name">${stockName}</div>`;
    html += `<div class="sheet-stock-shows">${shows} 언급</div>`;

    if (notes.length > 0) {
      // notes 우선 표시
      notes.forEach(pt => {
        html += `<div class="sheet-point"><span class="sheet-point-show">${pt.show}</span><span class="sheet-point-body">${pt.view}</span></div>`;
      });
      // 관련 comparison의 PICK이 있으면 추가
      related.forEach(comp => {
        html += `<div class="sheet-pick"><div class="sheet-pick-label">PICK</div>${comp.pick}</div>`;
      });
    } else if (related.length > 0) {
      // notes 없으면 comparisons fallback
      related.forEach(comp => {
        html += `<div class="sheet-comp-title">${comp.stock}</div>`;
        comp.points.forEach(pt => {
          html += `<div class="sheet-point"><span class="sheet-point-show">${pt.show}</span><span class="sheet-point-body">${pt.view}</span></div>`;
        });
        html += `<div class="sheet-pick"><div class="sheet-pick-label">PICK</div>${comp.pick}</div>`;
      });
    } else {
      html += `<div class="sheet-no-comp">이 종목은 여러 방송에서 언급됐지만, 별도 내용 정리가 없어요.</div>`;
    }

    html += `<a class="sheet-history" href="/stock/${stockName}">방송 언급 히스토리 보기 →</a>`;
    content.innerHTML = html;
    backdrop.classList.add('open');
    sheet.classList.add('open');
    sheet.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    backdrop.classList.remove('open');
    sheet.classList.remove('open');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.stock-row--clickable').forEach(btn => {
    btn.addEventListener('click', () => {
      const stockName = btn.dataset.stock;
      const shows = btn.querySelector('.stock-shows')?.textContent ?? '';
      openSheet(stockName, shows);
    });
  });

  sheet.addEventListener('click', closeModal);
  document.getElementById('stock-modal-close').addEventListener('click', closeModal);
  document.querySelector('.stock-modal-inner').addEventListener('click', e => e.stopPropagation());
</script>

<script define:vars={{ date, supabaseUrl, supabaseKey }}>
  fetch(`${supabaseUrl}/rest/v1/rpc/increment_daily_report_view`, {
    method: 'POST',
    headers: { 'apikey': supabaseKey, 'Authorization': `Bearer ${supabaseKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ report_date: date }),
  });
</script>

<script>
  const hero = document.querySelector('.report-hero') as HTMLElement;
  const hdrInner = document.querySelector('.hdr-inner') as HTMLElement;

  if (hero && hdrInner) {
    const ctx = document.createElement('div');
    ctx.className = 'hdr-ctx';

    const backBtn = document.createElement('button');
    backBtn.className = 'hdr-back-btn';
    backBtn.setAttribute('aria-label', '뒤로');
    backBtn.textContent = '←';
    backBtn.addEventListener('click', () => history.back());

    const label = document.createElement('span');
    label.className = 'hdr-ctx-label';
    label.textContent = 'PICK 리포트';

    ctx.appendChild(backBtn);
    ctx.appendChild(label);
    hdrInner.appendChild(ctx);

    const observer = new IntersectionObserver(
      ([entry]) => {
        hdrInner.classList.toggle('is-scrolled', !entry.isIntersecting);
      },
      { threshold: 0, rootMargin: '-56px 0px 0px 0px' }
    );
    observer.observe(hero);
  }
</script>
