---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAdmin } from '../../../lib/adminGuard';

if (!Astro.locals.session) return Astro.redirect('/admin/login');
if (!isAdmin(Astro.locals.user?.email)) return Astro.redirect('/');

const { id } = Astro.params;
const supabase = Astro.locals.supabase;
const SHOWS = ['12시에 만나요', '삼프로TV', '한국경제TV', '연합뉴스경제TV'];

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const title = String(form.get('title') ?? '').trim();
  const slug = String(form.get('slug') ?? '').trim();
  const show = String(form.get('show') ?? '').trim();
  const date = String(form.get('date') ?? '').trim();
  const summary = String(form.get('summary') ?? '').trim();
  const content = String(form.get('content') ?? '').trim();
  const hosts = String(form.get('hosts') ?? '').trim();
  const tags = String(form.get('tags') ?? '').trim();
  const display_order = parseInt(String(form.get('display_order') ?? '0'));
  const is_premium = form.get('is_premium') === 'true';
  const published = form.get('published') === 'true';

  if (!title || !slug || !date) {
    error = '제목, 슬러그, 날짜는 필수예요.';
  } else {
    const { error: dbErr } = await supabase
      .from('posts')
      .update({ title, slug, show, date, summary, content, hosts, tags, display_order, is_premium, published })
      .eq('id', id);
    if (dbErr) error = dbErr.message;
    else return Astro.redirect('/admin/posts');
  }
}

const { data: post } = await supabase.from('posts').select('*').eq('id', id).single();
if (!post) return Astro.redirect('/admin/posts');
---

<AdminLayout title="글 수정">
  <div class="form-wrap">
    {error && <div class="form-error">{error}</div>}
    <form method="POST" class="post-form">

      <div class="form-section">
        <h2 class="section-title">기본 정보</h2>
        <div class="form-field">
          <label class="form-label">제목 <span class="required">*</span></label>
          <input class="form-input" type="text" name="title" value={post.title} required />
        </div>
        <div class="form-row">
          <div class="form-field flex-1">
            <label class="form-label">슬러그 <span class="required">*</span></label>
            <input class="form-input" type="text" name="slug" value={post.slug} required />
          </div>
          <div class="form-field">
            <label class="form-label">날짜 <span class="required">*</span></label>
            <input class="form-input" type="date" name="date" value={post.date} required />
          </div>
          <div class="form-field">
            <label class="form-label">표시 순서</label>
            <input class="form-input" type="number" name="display_order" value={post.display_order ?? 0} min="0" style="width:90px" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field flex-1">
            <label class="form-label">방송</label>
            <select class="form-select" name="show">
              <option value="">선택 안 함</option>
              {SHOWS.map(s => <option value={s} selected={post.show === s}>{s}</option>)}
            </select>
          </div>
          <div class="form-field flex-1">
            <label class="form-label">진행자</label>
            <input class="form-input" type="text" name="hosts" value={post.hosts ?? ''} />
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="section-title">내용</h2>
        <div class="form-field">
          <label class="form-label">요약</label>
          <textarea class="form-textarea" name="summary" rows="3">{post.summary ?? ''}</textarea>
        </div>
        <div class="form-field">
          <label class="form-label">본문 (마크다운)</label>
          <textarea class="form-textarea" name="content" rows="16">{post.content ?? ''}</textarea>
        </div>
        <div class="form-field">
          <label class="form-label">태그 (쉼표로 구분)</label>
          <input class="form-input" type="text" name="tags" value={post.tags ?? ''} />
        </div>
      </div>

      <div class="form-section">
        <h2 class="section-title">공개 설정</h2>
        <div class="form-row">
          <div class="form-field">
            <label class="form-label">멤버십</label>
            <div class="form-radio-group">
              <label class="radio-label"><input type="radio" name="is_premium" value="false" checked={!post.is_premium} /> 무료</label>
              <label class="radio-label"><input type="radio" name="is_premium" value="true" checked={post.is_premium} /> 프리미엄</label>
            </div>
          </div>
          <div class="form-field">
            <label class="form-label">상태</label>
            <div class="form-radio-group">
              <label class="radio-label"><input type="radio" name="published" value="false" checked={!post.published} /> 임시저장</label>
              <label class="radio-label"><input type="radio" name="published" value="true" checked={post.published} /> 게시</label>
            </div>
          </div>
        </div>
      </div>

      <div class="form-btns">
        <a href="/admin/posts" class="btn-cancel">취소</a>
        <button type="submit" class="btn-primary">저장하기</button>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-wrap { max-width: 860px; }
  .form-error { background: #fee2e2; color: #dc2626; border-radius: 8px; padding: 12px 16px; font-size: 14px; margin-bottom: 16px; }
  .post-form { display: flex; flex-direction: column; gap: 16px; }
  .form-section { background: #fff; border-radius: 12px; border: 1px solid #e8eaed; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .section-title { font-size: 14px; font-weight: 700; color: #555; margin-bottom: 4px; }
  .form-field { display: flex; flex-direction: column; gap: 6px; }
  .form-row { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
  .flex-1 { flex: 1; min-width: 160px; }
  .form-label { font-size: 13px; font-weight: 700; color: #444; }
  .required { color: #ef4444; }
  .form-input { height: 42px; border-radius: 8px; border: 1.5px solid #e8eaed; padding: 0 12px; font-size: 14px; color: #111; outline: none; transition: border-color 140ms; width: 100%; }
  .form-input:focus { border-color: #ed781f; }
  .form-select { height: 42px; border-radius: 8px; border: 1.5px solid #e8eaed; padding: 0 12px; font-size: 14px; color: #111; outline: none; background: #fff; width: 100%; }
  .form-select:focus { border-color: #ed781f; }
  .form-textarea { border-radius: 8px; border: 1.5px solid #e8eaed; padding: 10px 12px; font-size: 14px; color: #111; outline: none; resize: vertical; line-height: 1.65; transition: border-color 140ms; width: 100%; font-family: 'Pretendard', monospace; }
  .form-textarea:focus { border-color: #ed781f; }
  .form-radio-group { display: flex; gap: 16px; height: 42px; align-items: center; }
  .radio-label { display: flex; align-items: center; gap: 6px; font-size: 14px; color: #555; cursor: pointer; }
  .form-btns { display: flex; gap: 8px; justify-content: flex-end; }
  .btn-cancel { height: 38px; padding: 0 16px; border-radius: 8px; background: #f2f4f6; color: #555; font-size: 14px; font-weight: 600; display: flex; align-items: center; text-decoration: none; }
  .btn-cancel:hover { background: #e8eaed; }
  .btn-primary { height: 38px; padding: 0 20px; border-radius: 8px; background: #ed781f; color: #fff; border: none; font-size: 14px; font-weight: 700; cursor: pointer; }
  .btn-primary:hover { opacity: 0.88; }
</style>
