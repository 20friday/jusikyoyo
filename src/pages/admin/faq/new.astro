---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAdmin } from '../../../lib/adminGuard';

if (!Astro.locals.session) return Astro.redirect('/login');
if (!isAdmin(Astro.locals.user?.email)) return Astro.redirect('/');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const question = String(form.get('question') ?? '').trim();
  const answer = String(form.get('answer') ?? '').trim();
  const is_published = form.get('is_published') === 'true';
  const sort_order = parseInt(String(form.get('sort_order') ?? '0'));

  if (!question) { error = '질문을 입력해주세요.'; }
  else {
    const { error: dbErr } = await Astro.locals.supabase
      .from('faqs').insert({ question, answer, is_published, sort_order });
    if (dbErr) error = dbErr.message;
    else return Astro.redirect('/admin/faq');
  }
}
---

<AdminLayout title="FAQ 추가">
  <div class="form-wrap">
    {error && <div class="form-error">{error}</div>}
    <form method="POST" class="faq-form">
      <div class="form-field">
        <label class="form-label">질문</label>
        <input class="form-input" type="text" name="question" placeholder="자주 묻는 질문을 입력하세요" required />
      </div>
      <div class="form-field">
        <label class="form-label">답변</label>
        <textarea class="form-textarea" name="answer" rows="8" placeholder="답변 내용을 입력하세요"></textarea>
      </div>
      <div class="form-row">
        <div class="form-field flex-1">
          <label class="form-label">순서 (숫자가 작을수록 위에 표시)</label>
          <input class="form-input" type="number" name="sort_order" value="0" min="0" />
        </div>
        <div class="form-field">
          <label class="form-label">상태</label>
          <div class="form-publish">
            <label class="publish-label"><input type="radio" name="is_published" value="false" checked /> 임시저장</label>
            <label class="publish-label"><input type="radio" name="is_published" value="true" /> 즉시 게시</label>
          </div>
        </div>
      </div>
      <div class="form-btns">
        <a href="/admin/faq" class="btn-cancel">취소</a>
        <button type="submit" class="btn-primary">저장하기</button>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .form-wrap { max-width: 760px; }
  .form-error { background: #fee2e2; color: #dc2626; border-radius: 8px; padding: 12px 16px; font-size: 14px; margin-bottom: 16px; }
  .faq-form { background: #fff; border-radius: 12px; border: 1px solid #e8eaed; padding: 24px; display: flex; flex-direction: column; gap: 20px; }
  .form-field { display: flex; flex-direction: column; gap: 7px; }
  .form-row { display: flex; gap: 20px; align-items: flex-start; }
  .flex-1 { flex: 1; }
  .form-label { font-size: 13px; font-weight: 700; color: #444; }
  .form-input { height: 44px; border-radius: 8px; border: 1.5px solid #e8eaed; padding: 0 14px; font-size: 15px; color: #111; outline: none; transition: border-color 140ms; }
  .form-input:focus { border-color: #ed781f; }
  .form-textarea { border-radius: 8px; border: 1.5px solid #e8eaed; padding: 12px 14px; font-size: 15px; color: #111; outline: none; resize: vertical; line-height: 1.65; transition: border-color 140ms; }
  .form-textarea:focus { border-color: #ed781f; }
  .form-publish { display: flex; gap: 16px; height: 44px; align-items: center; }
  .publish-label { display: flex; align-items: center; gap: 6px; font-size: 14px; color: #555; cursor: pointer; }
  .form-btns { display: flex; gap: 8px; justify-content: flex-end; }
  .btn-cancel { height: 38px; padding: 0 16px; border-radius: 8px; background: #f2f4f6; color: #555; font-size: 14px; font-weight: 600; display: flex; align-items: center; text-decoration: none; }
  .btn-cancel:hover { background: #e8eaed; }
  .btn-primary { height: 38px; padding: 0 20px; border-radius: 8px; background: #ed781f; color: #fff; border: none; font-size: 14px; font-weight: 700; cursor: pointer; }
  .btn-primary:hover { opacity: 0.88; }
</style>
