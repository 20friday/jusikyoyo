---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAdmin } from '../../../lib/adminGuard';

if (!Astro.locals.session) return Astro.redirect('/admin/login');
if (!isAdmin(Astro.locals.user?.email)) return Astro.redirect('/');

const { data: reports } = await Astro.locals.supabase
  .from('weekly_reports')
  .select('id, date, period, headline, published, view_count')
  .order('date', { ascending: false });
---

<AdminLayout title="주간 픽 관리">
  <div class="list-header">
    <div class="table-meta">총 {reports?.length ?? 0}개</div>
    <a href="/admin/weekly/new" class="btn-new">+ 새 주간 픽</a>
  </div>
  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>날짜</th>
          <th>기간</th>
          <th>헤드라인</th>
          <th>상태</th>
          <th class="th-views">조회수</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {reports?.map(r => (
          <tr>
            <td class="td-date">{r.date}</td>
            <td class="td-gray">{r.period ?? '—'}</td>
            <td class="td-headline">{r.headline ?? '—'}</td>
            <td>
              {r.published
                ? <span class="badge published">게시</span>
                : <span class="badge draft">임시</span>
              }
            </td>
            <td class="td-views">{r.view_count ?? 0}</td>
            <td class="td-actions">
              <a href={`/weekly/${r.date}`} target="_blank" class="action-btn">보기</a>
              <a href={`/admin/weekly/${r.id}`} class="action-btn">수정</a>
              <button class="action-btn danger" data-id={r.id} data-title={r.date}>삭제</button>
            </td>
          </tr>
        ))}
        {(!reports || reports.length === 0) && (
          <tr><td colspan="6" class="td-empty">주간 픽이 없어요</td></tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.danger').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      const title = (btn as HTMLElement).dataset.title;
      if (!confirm(`${title} 주간 픽을 삭제할까요?`)) return;
      const res = await fetch(`/api/admin/weekly/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('삭제 실패: ' + await res.text());
    });
  });
</script>

<style>
  .list-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .table-meta { font-size: 13px; color: #888; }
  .btn-new { height: 34px; padding: 0 16px; background: #ed781f; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 700; display: flex; align-items: center; }
  .btn-new:hover { opacity: 0.88; }
  .table-wrap { background: #fff; border-radius: 12px; border: 1px solid #e8eaed; overflow: hidden; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .admin-table th { background: #f9fafb; text-align: left; padding: 11px 16px; font-size: 12px; font-weight: 700; color: #888; border-bottom: 1px solid #e8eaed; }
  .admin-table td { padding: 12px 16px; border-bottom: 1px solid #f0f1f3; color: #333; vertical-align: middle; }
  .admin-table tr:last-child td { border-bottom: none; }
  .admin-table tr:hover td { background: #fafafa; }
  .th-views { text-align: right; width: 70px; white-space: nowrap; }
  .td-date { font-weight: 700; white-space: nowrap; color: #555; width: 110px; }
  .td-gray { color: #999; font-size: 13px; white-space: nowrap; }
  .td-headline { max-width: 420px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
  .td-views { color: #999; font-size: 13px; text-align: right; white-space: nowrap; }
  .td-empty { text-align: center; color: #bbb; padding: 40px; }
  .td-actions { white-space: nowrap; display: flex; gap: 6px; align-items: center; }
  .badge { font-size: 11px; font-weight: 700; border-radius: 5px; padding: 2px 7px; }
  .badge.published { background: #dcfce7; color: #16a34a; }
  .badge.draft { background: #f1f5f9; color: #94a3b8; }
  .action-btn { font-size: 12px; font-weight: 600; color: #555; background: #f2f4f6; border: none; border-radius: 6px; padding: 5px 10px; text-decoration: none; display: inline-block; cursor: pointer; transition: background 120ms; }
  .action-btn:hover { background: #e8eaed; }
  .action-btn.danger { color: #ef4444; background: #fff1f1; }
  .action-btn.danger:hover { background: #fecaca; }
</style>
