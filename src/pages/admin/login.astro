---
import { isAdmin } from '../../lib/adminGuard';

// 이미 로그인된 관리자면 대시보드로
if (Astro.locals.session && isAdmin(Astro.locals.user?.email)) {
  return Astro.redirect('/admin');
}

let sent = false;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();

  if (!email) {
    error = '이메일을 입력해주세요.';
  } else if (!isAdmin(email)) {
    error = '관리자 계정이 아니에요.';
  } else {
    const { error: authErr } = await Astro.locals.supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: `${Astro.url.origin}/api/auth/callback?next=/admin` },
    });
    if (authErr) error = authErr.message;
    else sent = true;
  }
}
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>관리자 로그인 — TED PICK</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="page">
    <div class="card">
      <div class="card-icon">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="10" fill="#ed781f"/>
          <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-size="14" font-weight="800" fill="white" font-family="system-ui">TP</text>
        </svg>
      </div>

      {sent ? (
        <>
          <h1 class="card-title">메일을 확인하세요</h1>
          <p class="card-sub sent-sub">
            <strong>20friday@gmail.com</strong>으로<br />로그인 링크를 보냈어요.<br />메일함에서 링크를 클릭하면 바로 접속돼요.
          </p>
        </>
      ) : (
        <>
          <h1 class="card-title">관리자 로그인</h1>
          <p class="card-sub">TED PICK 관리자 계정으로 로그인하세요</p>

          {error && <div class="error-msg">{error}</div>}

          <form method="POST" class="login-form">
            <div class="field">
              <label class="field-label">관리자 이메일</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="7" r="3.5" stroke="#94a3b8" stroke-width="1.6"/>
                    <path d="M3 17c0-3.314 3.134-5 7-5s7 1.686 7 5" stroke="#94a3b8" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </span>
                <input class="field-input" type="email" name="email" placeholder="관리자 이메일 주소" autocomplete="email" required />
              </div>
            </div>
            <button type="submit" class="btn-login">로그인 링크 받기</button>
          </form>
        </>
      )}
    </div>
  </div>
</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #eef1f6;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .page {
    width: 100%;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 32px rgba(0,0,0,0.08);
    padding: 40px 36px 36px;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .card-icon { margin-bottom: 16px; }
  .card-title {
    font-size: 22px;
    font-weight: 800;
    color: #111;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }
  .card-sub {
    font-size: 14px;
    color: #94a3b8;
    margin-bottom: 28px;
    text-align: center;
  }
  .sent-sub {
    line-height: 1.8;
    color: #64748b;
  }
  .sent-sub strong { color: #111; }
  .error-msg {
    width: 100%;
    background: #fee2e2;
    color: #dc2626;
    border-radius: 10px;
    padding: 11px 14px;
    font-size: 13.5px;
    margin-bottom: 16px;
    text-align: center;
  }
  .login-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.02em;
  }
  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-icon {
    position: absolute;
    left: 13px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .field-input {
    width: 100%;
    height: 48px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 0 14px 0 40px;
    font-size: 14.5px;
    color: #111;
    outline: none;
    transition: border-color 150ms;
    background: #f8fafc;
  }
  .field-input::placeholder { color: #c0ccd8; }
  .field-input:focus {
    border-color: #ed781f;
    background: #fff;
  }
  .btn-login {
    margin-top: 4px;
    width: 100%;
    height: 50px;
    background: #ed781f;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 140ms;
    letter-spacing: -0.01em;
  }
  .btn-login:hover { opacity: 0.88; }
  .btn-login:active { opacity: 0.78; }
</style>
