---
import { isAdmin } from '../../lib/adminGuard';

// 이미 로그인된 관리자면 대시보드로
if (Astro.locals.session && isAdmin(Astro.locals.user?.email)) {
  return Astro.redirect('/admin');
}

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  if (!email || !password) {
    error = '이메일과 비밀번호를 입력해주세요.';
  } else {
    const { data, error: authErr } = await Astro.locals.supabase.auth.signInWithPassword({ email, password });
    if (authErr || !data.user) {
      error = '이메일 또는 비밀번호가 올바르지 않아요.';
    } else if (!isAdmin(data.user.email)) {
      await Astro.locals.supabase.auth.signOut();
      error = '관리자 계정이 아니에요.';
    } else {
      return Astro.redirect('/admin');
    }
  }
}
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>관리자 로그인 — TED PICK</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="page">
    <div class="card">
      <div class="card-icon">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <rect width="36" height="36" rx="10" fill="#ed781f"/>
          <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" font-size="14" font-weight="800" fill="white" font-family="system-ui">TP</text>
        </svg>
      </div>
      <h1 class="card-title">관리자 로그인</h1>
      <p class="card-sub">TED PICK 관리자 계정으로 로그인하세요</p>

      {error && <div class="error-msg">{error}</div>}

      <form method="POST" class="login-form">
        <div class="field">
          <label class="field-label">이메일</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="7" r="3.5" stroke="#94a3b8" stroke-width="1.6"/>
                <path d="M3 17c0-3.314 3.134-5 7-5s7 1.686 7 5" stroke="#94a3b8" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
            <input class="field-input" type="email" name="email" placeholder="admin@example.com" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label class="field-label">비밀번호</label>
          <div class="input-wrap">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                <rect x="4" y="9" width="12" height="9" rx="2" stroke="#94a3b8" stroke-width="1.6"/>
                <path d="M7 9V6a3 3 0 0 1 6 0v3" stroke="#94a3b8" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
            <input class="field-input" type="password" name="password" id="pw-input" placeholder="비밀번호" autocomplete="current-password" required />
            <button type="button" class="pw-toggle" id="pw-toggle" aria-label="비밀번호 보기">
              <svg id="eye-on" width="17" height="17" viewBox="0 0 20 20" fill="none">
                <ellipse cx="10" cy="10" rx="8" ry="5" stroke="#94a3b8" stroke-width="1.6"/>
                <circle cx="10" cy="10" r="2.5" stroke="#94a3b8" stroke-width="1.6"/>
              </svg>
              <svg id="eye-off" width="17" height="17" viewBox="0 0 20 20" fill="none" style="display:none">
                <path d="M3 3l14 14M8.5 8.7A2.5 2.5 0 0 0 11.3 11.5M6.2 6.4C4.6 7.3 3.3 8.6 2 10c2 2.8 5.2 5 8 5 1.3 0 2.6-.4 3.8-1M10 5c2.8 0 6 2.2 8 5-0.6.9-1.4 1.7-2.2 2.4" stroke="#94a3b8" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>
        <button type="submit" class="btn-login">로그인</button>
      </form>
    </div>
  </div>

  <script>
    const toggle = document.getElementById('pw-toggle');
    const input = document.getElementById('pw-input') as HTMLInputElement;
    const eyeOn = document.getElementById('eye-on');
    const eyeOff = document.getElementById('eye-off');
    toggle?.addEventListener('click', () => {
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      eyeOn!.style.display = isHidden ? 'none' : '';
      eyeOff!.style.display = isHidden ? '' : 'none';
    });
  </script>
</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #eef1f6;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .page {
    width: 100%;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 32px rgba(0,0,0,0.08);
    padding: 40px 36px 36px;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .card-icon {
    margin-bottom: 16px;
  }
  .card-title {
    font-size: 22px;
    font-weight: 800;
    color: #111;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }
  .card-sub {
    font-size: 14px;
    color: #94a3b8;
    margin-bottom: 28px;
  }
  .error-msg {
    width: 100%;
    background: #fee2e2;
    color: #dc2626;
    border-radius: 10px;
    padding: 11px 14px;
    font-size: 13.5px;
    margin-bottom: 16px;
    text-align: center;
  }
  .login-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.02em;
  }
  .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-icon {
    position: absolute;
    left: 13px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .field-input {
    width: 100%;
    height: 48px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 0 44px 0 40px;
    font-size: 14.5px;
    color: #111;
    outline: none;
    transition: border-color 150ms;
    background: #f8fafc;
  }
  .field-input::placeholder { color: #c0ccd8; }
  .field-input:focus {
    border-color: #ed781f;
    background: #fff;
  }
  .pw-toggle {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 4px;
    color: #94a3b8;
  }
  .btn-login {
    margin-top: 6px;
    width: 100%;
    height: 50px;
    background: #ed781f;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 140ms;
    letter-spacing: -0.01em;
  }
  .btn-login:hover { opacity: 0.88; }
  .btn-login:active { opacity: 0.78; }
</style>
