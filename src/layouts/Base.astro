---
import SiteFooter from '../components/SiteFooter.astro';
import SiteFooterMin from '../components/SiteFooterMin.astro';

interface Props {
  title?: string;
  description?: string;
  footer?: 'default' | 'minimal' | 'none';
}
const { title = '테드픽', description = '매일 12시, 장 정리', footer = 'default' } = Astro.props;
const { user } = Astro.locals;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — 테드픽</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="app">
    <header class="hdr">
      <div class="hdr-inner">
        <a href="/" class="brand">
          <img src="/ted_logo.svg" alt="테드픽" class="brand-logo" />
        </a>
        <div class="hdr-spacer"></div>
        {user ? (
          <a href="/mypage" class="hamburger-btn" aria-label="메뉴">
            <span></span>
            <span></span>
            <span></span>
          </a>
        ) : (
          <a href="/login" class="btn-pill ghost">로그인</a>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    {footer === 'default' && <SiteFooter />}
    {footer === 'minimal' && <SiteFooterMin />}

  </div>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  /* ── 햄버거 버튼 ── */
  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    padding: 4px;
    border-radius: 8px;
    transition: background 140ms;
    text-decoration: none;
  }
  .hamburger-btn:hover { background: var(--divider); }
  .hamburger-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-1);
    border-radius: 2px;
  }
</style>
